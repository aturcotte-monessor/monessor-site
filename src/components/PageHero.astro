---
// Héros foncé des pages de contenu (Approche, À propos, Confidentialité), avec le faisceau de lignes.
import ContactCta from './ContactCta.astro';
import ChevronLines from './ChevronLines.astro';
import { meetingUrl, meetingLabel, fathomEvent } from '../utils/tracking';

interface Props {
  locale: 'fr' | 'en';
  kicker: string;
  title: string;
  lead?: string;
  /** Bouton de rendez-vous dans le héros (désactivé sur la page de confidentialité). */
  cta?: boolean;
}

const { locale, kicker, title, lead, cta = true } = Astro.props;
const pathname = Astro.url.pathname;
---

<section class="relative overflow-hidden bg-teal-deep">
  <ChevronLines class="h-[112px] w-[168px] lg:h-[200px] lg:w-[300px] xl:h-[300px] xl:w-[450px]" />
  <div class="relative mx-auto max-w-7xl px-6 pt-20 pb-28 lg:px-8 lg:py-28">
    <p class="home-kicker text-coral">{kicker}</p>
    <h1 class="home-h1">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-light/85">{lead}</p>}
    {cta && (
      <div class="mt-8">
        <ContactCta
          href={meetingUrl(locale)}
          label={meetingLabel(locale)}
          className="btn"
          fathomEventName={fathomEvent('ScheduleMeeting', 'Hero', locale, pathname)}
        />
      </div>
    )}
  </div>
</section>
