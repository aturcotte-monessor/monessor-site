---
// Gabarit commun des articles : /fr/perspectives/<slug>/ et /en/insights/<slug>/.
// Ordre : fil d'Ariane, en-tête, corps (colonne de lecture ≈ 70 caractères), note de transparence,
// encadré auteur, vignette de rendez-vous du segment, FAQ, articles liés.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import MeetingCta from './MeetingCta.astro';
import InsightCard from './InsightCard.astro';
import { articleSegments, relatedArticles, segmentLabels } from '../utils/articleSegments';
import { formatDate } from '../utils/dates';
import { fathomEvent } from '../utils/tracking';

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const locale = entry.data.lang;
const pathname = Astro.url.pathname;
const siteUrl = 'https://www.monessor.com';
const currentUrl = new URL(pathname, siteUrl).href;

const all = await getCollection('insights', ({ data }) => !data.draft);
const segments = articleSegments(entry, all);
const related = relatedArticles(entry, all);
const { Content } = await render(entry);

const author = entry.data.author || 'Alex Turcotte';
const base = locale === 'fr' ? '/fr/perspectives/' : '/en/insights/';
const hrefOf = (e: CollectionEntry<'insights'>) => `${base}${e.id.replace(/^(fr|en)\//, '')}/`;

const t = {
  fr: {
    section: 'Perspectives',
    breadcrumb: 'Fil d’Ariane',
    published: 'Publié le',
    updated: 'mis à jour le',
    read: 'de lecture',
    transparencyLabel: 'Note de transparence : ',
    transparency: `Ce texte a été pensé et structuré par ${author}, puis rédigé avec l'assistance de l'intelligence artificielle, dans une voix calibrée sur ses propres écrits. L'IA a aussi servi à la recherche documentaire et à la traduction. Le fond de la pensée et le retour d'expérience d'affaires sont les siens.`,
    authorRole: 'associé directeur',
    authorLine: 'Plus de vingt ans à la jonction de la technologie, du produit et de la gouvernance. Il accompagne les dirigeants de PME et de la finance réglementée.',
    profile: 'Profil du fondateur →',
    profileHref: '/fr/a-propos/',
    portraitAlt: 'Portrait d’Alex Turcotte',
    faq: 'Questions fréquentes',
    related: 'À lire aussi',
    jobTitle: 'Associé directeur',
    inLanguage: 'fr-CA',
    imageAlt: 'Monessor, conseil en gestion stratégique des TI'
  },
  en: {
    section: 'Insights',
    breadcrumb: 'Breadcrumb',
    published: 'Published',
    updated: 'updated',
    read: 'read',
    transparencyLabel: 'Transparency note: ',
    transparency: `This text was conceived and structured by ${author}, then written with the assistance of artificial intelligence, in a voice calibrated on his own writing. AI was also used for background research and translation. The core ideas and the real-world business experience are his own.`,
    authorRole: 'Managing Partner',
    authorLine: 'More than twenty years where technology, product and governance meet. He works with leaders of SMEs and regulated financial institutions.',
    profile: 'Founder profile →',
    profileHref: '/en/about/',
    portraitAlt: 'Portrait of Alex Turcotte',
    faq: 'Frequently asked questions',
    related: 'Further reading',
    jobTitle: 'Managing Partner',
    inLanguage: 'en-CA',
    imageAlt: 'Monessor, strategic IT management advisory'
  }
}[locale];

const updated = entry.data.updatedDate && entry.data.updatedDate.getTime() !== entry.data.pubDate.getTime() ? entry.data.updatedDate : undefined;
const isoDay = (d: Date) => d.toISOString().slice(0, 10);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrl },
  headline: entry.data.title,
  description: entry.data.excerpt,
  inLanguage: t.inLanguage,
  url: currentUrl,
  datePublished: isoDay(entry.data.pubDate),
  dateModified: isoDay(entry.data.updatedDate || entry.data.pubDate),
  author: {
    '@type': 'Person',
    name: author,
    jobTitle: t.jobTitle,
    url: new URL(t.profileHref, siteUrl).href,
    sameAs: ['https://www.linkedin.com/in/turcottealex']
  },
  image: { '@type': 'ImageObject', url: `${siteUrl}/assets/og-insight-default.png`, width: 1200, height: 627 },
  publisher: {
    '@type': 'Organization',
    name: 'Monessor',
    legalName: 'Services-conseils Monessor inc.',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/assets/monessor-logo.png` }
  },
  ...(entry.data.tags && { keywords: entry.data.tags.join(', ') })
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.section, item: new URL(base, siteUrl).href },
    { '@type': 'ListItem', position: 2, name: entry.data.title, item: currentUrl }
  ]
};

const faq = entry.data.faq ?? [];
const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } }))
    }
  : null;
---

<Layout
  locale={locale}
  title={`${entry.data.title} | Monessor`}
  description={entry.data.excerpt}
  image="/assets/og-insight-default.png"
  ogType="article"
  ogTitle={entry.data.title}
  meeting={false}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={entry.data.pubDate.toISOString()} />
    {entry.data.updatedDate && <meta property="article:modified_time" content={entry.data.updatedDate.toISOString()} />}
    <meta property="article:author" content={author} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={t.imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <section class="bg-light py-12 text-ink md:py-16">
    <article class="mx-auto max-w-3xl px-6">
      <!-- FIL D'ARIANE -->
      <nav aria-label={t.breadcrumb} class="text-sm">
        <ol class="flex flex-wrap items-center gap-2 text-slate-600">
          <li><a href={base} class="font-semibold text-teal underline underline-offset-4">{t.section}</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="line-clamp-1 max-w-full">{entry.data.title}</li>
        </ol>
      </nav>

      <!-- EN-TÊTE -->
      <header class="mt-8">
        {segments.length > 0 && (
          <p class="flex flex-wrap gap-2">
            {segments.map((s) => (
              <span class="rounded-full border border-teal/30 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-teal">{segmentLabels[locale][s]}</span>
            ))}
          </p>
        )}
        <h1 class="article-title">{entry.data.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-700">{entry.data.excerpt}</p>
        <p class="mt-5 text-sm text-slate-600">
          {author}
          {' · '}{t.published} <time datetime={isoDay(entry.data.pubDate)}>{formatDate(entry.data.pubDate, locale)}</time>
          {updated && <span>, {t.updated} <time datetime={isoDay(updated)}>{formatDate(updated, locale)}</time></span>}
          {entry.data.readTime && <span>{' · '}{entry.data.readTime} {t.read}</span>}
        </p>
      </header>

      <!-- CORPS : colonne de lecture d'environ 70 caractères -->
      <div class="insight-content article-prose mt-10 max-w-[70ch] [&_p]:text-slate-800 [&>p]:mb-6 [&>p]:leading-relaxed [&_h2]:text-teal [&_h2]:font-semibold [&>h2]:mt-10 [&>h2]:mb-4 [&_h3]:text-teal [&_h3]:font-semibold [&>h3]:mt-8 [&>h3]:mb-3 [&_a]:text-teal [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-teal/40 [&_a]:transition-colors hover:[&_a]:decoration-teal [&_ul]:text-slate-700 [&>ul]:my-6 [&>ul]:space-y-2 [&>ul]:list-disc [&>ul]:pl-6 [&_ol]:text-slate-700 [&>ol]:my-6 [&>ol]:space-y-2 [&>ol]:list-decimal [&>ol]:pl-6 [&_blockquote]:text-slate-700 [&_li]:text-slate-700 [&>hr]:mt-12 [&>hr]:mb-12 [&>hr]:border-slate-200 [&>hr]:opacity-30">
        <Content />
        <p class="mt-8 border-t border-slate-200 pt-4 text-sm italic"><strong>{t.transparencyLabel}</strong>{t.transparency}</p>
      </div>

      <!-- AUTEUR -->
      <aside class="mt-10 flex flex-col gap-5 rounded-2xl border border-slate-200 bg-white p-6 sm:flex-row sm:items-start" aria-label={author}>
        <img src="/assets/alex.jpg" alt={t.portraitAlt} width="80" height="80" loading="lazy" decoding="async" class="h-20 w-20 shrink-0 rounded-xl object-cover" />
        <div>
          <p class="font-semibold text-teal">{author}, {t.authorRole}</p>
          <p class="mt-1 leading-relaxed">{t.authorLine}</p>
          <p class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href={t.profileHref} class="font-semibold text-teal underline underline-offset-4">{t.profile}</a>
            <a
              href="https://www.linkedin.com/in/turcottealex"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-teal underline underline-offset-4"
              data-fathom-event={fathomEvent('LinkedIn', 'Author', locale, pathname)}
            >LinkedIn</a>
          </p>
        </div>
      </aside>

      <!-- VIGNETTE DE RENDEZ-VOUS DU SEGMENT -->
      <div class="mt-10">
        <MeetingCta locale={locale} variant={segments[0] ?? 'article'} placement="Article" bare serviceLink />
      </div>

      <!-- FAQ -->
      {faq.length > 0 && (
        <div class="mt-12">
          <h2 class="article-section-title">{t.faq}</h2>
          <div class="accordion-container mt-4 rounded-2xl border border-teal/10 bg-white">
            {faq.map((item, index) => (
              <div class="accordion-item">
                <button class="accordion-trigger" aria-expanded="false" aria-controls={`faq-${index}-content`}>
                  <span>{item.question}</span>
                  <svg class="accordion-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="accordion-content" id={`faq-${index}-content`}>
                  <p class="accordion-text">{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </article>
  </section>

  <!-- ARTICLES LIÉS -->
  {related.length > 0 && (
    <section class="bg-white py-14 text-ink">
      <div class="mx-auto max-w-5xl px-6">
        <h2 class="article-section-title">{t.related}</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {related.map((e) => (
            <InsightCard entry={e} href={hrefOf(e)} locale={locale} segments={articleSegments(e, all)} headingLevel={3} />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
