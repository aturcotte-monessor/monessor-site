---
import { getAlternatePath } from '../utils/i18nRoutes';
import ContactCta from './ContactCta.astro';
import { meetingUrl, meetingLabel as bookingLabel, fathomEvent } from '../utils/tracking';

interface Props {
  locale?: 'fr' | 'en';
  switchHref?: string;
}

const { locale = 'fr', switchHref } = Astro.props;
const isFr = locale === 'fr';

const homePath = isFr ? '/fr/' : '/en/';
const insightsPath = isFr ? '/fr/perspectives/' : '/en/insights/';
const switchLabel = isFr ? 'EN' : 'FR';
const switchAria = isFr ? 'English version' : 'Version française';
const pathname = Astro.url.pathname;

const switchPath = switchHref ?? (await getAlternatePath(pathname, isFr ? 'en' : 'fr'));
const meetingLabel = bookingLabel(locale);
const meetingHref = meetingUrl(locale);

const serviceLinks = isFr
  ? [
      {
        href: '/fr/services/pme/',
        label: 'PME',
        description: 'CTO à temps partagé, Transformation numérique & IA'
      },
      {
        href: '/fr/services/finance-reglementee/',
        label: 'Services financiers réglementés',
        description: 'Gouvernance TI & Conformité BSIF/OSFI'
      }
    ]
  : [
      {
        href: '/en/services/sme/',
        label: 'SMEs',
        description: 'Fractional CTO, Digital Transformation & AI'
      },
      {
        href: '/en/services/regulated-finance/',
        label: 'Regulated Financial Services',
        description: 'IT Governance & OSFI Compliance'
      }
    ];

const servicesLabel = 'Services';

const sectionLinks = isFr
  ? [
      { href: '/fr/approche/', label: 'Approche' },
      { href: insightsPath, label: 'Perspectives' },
      { href: '/fr/a-propos/', label: 'À propos' }
    ]
  : [
      { href: '/en/approach/', label: 'Approach' },
      { href: insightsPath, label: 'Insights' },
      { href: '/en/about/', label: 'About' }
    ];
---

<header
  data-site-header
  class="sticky top-0 z-50 border-b border-slate-200 bg-white transition-shadow duration-200 data-[scrolled]:shadow-[0_2px_12px_rgba(16,42,46,0.08)]"
>
  <div data-nosnippet>
    <nav class="max-w-7xl mx-auto px-6 lg:px-8 h-20 flex items-center justify-between gap-4" aria-label={isFr ? 'Navigation principale' : 'Main navigation'}>
      <a href={homePath} class="flex items-center gap-3 text-teal no-underline hover:no-underline hover:opacity-100">
        <img src="/assets/monessor-embleme.svg" alt="" width="34" height="35" class="h-[35px] w-[34px]" />
        <span class="wordmark text-lg">MONESSOR</span>
      </a>

      <!-- Mobile -->
      <details class="md:hidden relative" data-mobile-menu>
        <summary aria-controls="mobile-menu-panel" class="list-none inline-flex h-11 w-11 items-center justify-center rounded-md border border-slate-300 text-teal cursor-pointer">
          <span class="sr-only">Menu</span>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div id="mobile-menu-panel" class="absolute right-0 mt-3 w-72 max-w-[calc(100vw-48px)] rounded-xl border border-slate-200 bg-white p-3 shadow-xl">
          <div class="flex flex-col text-[15px] text-ink">
            <p class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-600">{servicesLabel}</p>
            <div class="mb-1 flex flex-col">
              {serviceLinks.map((link) => (
                <a href={link.href} class="flex min-h-11 flex-col justify-center rounded-md px-3 py-2 hover:bg-light hover:no-underline">
                  <span class="block font-medium text-teal">{link.label}</span>
                  <span class="block text-xs text-slate-600">{link.description}</span>
                </a>
              ))}
            </div>
            <hr class="my-1 border-slate-200" />
            {sectionLinks.map((link) => (
              <a href={link.href} class="flex min-h-11 items-center rounded-md px-3 hover:bg-light hover:text-teal">{link.label}</a>
            ))}
            <a href={switchPath} lang={isFr ? 'en' : 'fr'} class="flex min-h-11 items-center rounded-md px-3 hover:bg-light hover:text-teal">{switchLabel}<span class="sr-only">, {switchAria}</span></a>
            <ContactCta
              href={meetingHref}
              label={meetingLabel}
              className="btn mt-2 min-h-11"
              fathomEventName={fathomEvent('ScheduleMeeting', 'Header-Mobile', locale, pathname)}
            />
          </div>
        </div>
      </details>

      <!-- Bureau -->
      <div class="hidden md:flex items-center gap-6 text-sm text-ink">
        <div class="relative" data-services-menu>
          <button
            type="button"
            class="inline-flex min-h-11 items-center gap-1 hover:text-teal transition-colors"
            aria-expanded="false"
            aria-controls="services-menu-desktop"
          >
            {servicesLabel}
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div
            id="services-menu-desktop"
            class="hidden absolute left-0 top-full w-72 rounded-xl border border-slate-200 bg-white p-2 shadow-xl"
          >
            {serviceLinks.map((link) => (
              <a href={link.href} class="block min-h-11 rounded-lg px-3 py-2 hover:bg-light hover:no-underline">
                <span class="block font-semibold text-teal">{link.label}</span>
                <span class="block text-xs text-slate-600">{link.description}</span>
              </a>
            ))}
          </div>
        </div>
        {sectionLinks.map((link) => <a class="py-3 hover:text-teal transition-colors" href={link.href}>{link.label}</a>)}
        <a class="py-3 hover:text-teal transition-colors" href={switchPath} lang={isFr ? 'en' : 'fr'}>{switchLabel}<span class="sr-only">, {switchAria}</span></a>
        <ContactCta
          href={meetingHref}
          label={meetingLabel}
          className="btn"
          fathomEventName={fathomEvent('ScheduleMeeting', 'Header', locale, pathname)}
        />
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  // Ombre légère au défilement
  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Menu mobile : fermeture au clic extérieur, après un clic sur un lien et avec Échap
  const mobile = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (mobile) {
    document.addEventListener('click', (event) => {
      if (mobile.open && !mobile.contains(event.target as Node)) mobile.open = false;
    });
    mobile.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) mobile.open = false;
    });
    // Échap ferme le menu et rend le focus au bouton ; le menu se ferme aussi quand le focus en sort
    const summary = mobile.querySelector('summary');
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.open) {
        mobile.open = false;
        summary?.focus();
      }
    });
    mobile.addEventListener('focusout', (event) => {
      if (mobile.open && event.relatedTarget && !mobile.contains(event.relatedTarget as Node)) mobile.open = false;
    });
  }

  // Menu Services (bureau) : survol, clic et clavier, avec aria-expanded à jour
  const services = document.querySelector<HTMLElement>('[data-services-menu]');
  const trigger = services?.querySelector<HTMLButtonElement>('button');
  const panel = services?.querySelector<HTMLElement>('#services-menu-desktop');
  if (services && trigger && panel) {
    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
    };
    // Clavier (detail === 0) : bascule ; souris ou tactile : le survol a déjà ouvert le menu, on le garde ouvert
    trigger.addEventListener('click', (event) => {
      setOpen(event.detail === 0 ? trigger.getAttribute('aria-expanded') !== 'true' : true);
    });
    services.addEventListener('mouseenter', () => setOpen(true));
    services.addEventListener('mouseleave', () => setOpen(false));
    services.addEventListener('focusout', (event) => {
      if (!services.contains(event.relatedTarget as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        trigger.focus();
      }
    });
  }
</script>
