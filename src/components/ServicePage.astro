---
// Gabarit commun des pages de service (PME et services financiers, FR et EN).
// Chaque page fournit son contenu ; l'ordre des sections et le style sont définis ici.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContactCta from './ContactCta.astro';
import InsightCard from './InsightCard.astro';
import Icon from './Icon.astro';
import ChevronLines from './ChevronLines.astro';
import EssorPriceNote from './EssorPriceNote.astro';
import { meetingUrl, meetingLabel as bookingLabel, fathomEvent } from '../utils/tracking';
import { articleSegments } from '../utils/articleSegments';

type IconName = Parameters<typeof Icon>[0]['name'];
type Item = { icon?: IconName; title: string; text: string; meta?: string };

interface Props {
  locale: 'fr' | 'en';
  segment: 'pme' | 'sf';
  title: string;
  description: string;
  /** Données structurées Service / Offer. */
  jsonLd: Record<string, unknown>;
  hero: { kicker: string; title: string; lead: string; secondary: { label: string; href: string } };
  /** `audience` : repère de taille des clients, affiché sous le titre. */
  issues: { id: string; title: string; audience?: string; items: Item[] };
  /** `essor` : mention ESSOR sous le prix, liée à l'encadré `note` (id « essor »). */
  offer: { id: string; kicker: string; title: string; lead: string; price: string; essor?: boolean; items: Item[] };
  /** Deuxième offre : solutions logicielles sur mesure (PME seulement). */
  solutions?: {
    id: string;
    kicker: string;
    title: string;
    subtitle: string;
    promise: string;
    price: string;
    ai: { title: string; items: Item[] };
    examples: { title: string; items: Item[] };
    included: { title: string; items: Item[] };
    disciplines: { title: string; intro: string; items: Item[] };
    limits: { title: string; items: string[] };
    strategy: { text: string; link: { label: string; href: string } };
  };
  /** Démarche par étapes (PME seulement). */
  path?: { id: string; title: string; intro: string; steps: Item[] };
  /** Encadré affiché après les offres et les prix (ex. aide financière possible). */
  note?: { id?: string; title: string; text: string };
  expertise: { id: string; kicker?: string; title: string; items: Item[]; numbered?: boolean };
  /** translationKey des articles liés, dans l'ordre d'affichage. */
  insights: { title: string; keys: string[]; allLabel: string };
  neutrality: { id: string; title: string; text: string; delivery: string };
  other: { id: string; question: string; label: string; href: string };
}

const { locale, segment, title, description, jsonLd, hero, issues, offer, solutions, path, note, expertise, insights, neutrality, other } = Astro.props;
// Alternance des fonds clair / blanc : la section des solutions décale les suivantes d'un cran
const shade = (index: number) => ((index + (solutions ? 1 : 0)) % 2 === 0 ? 'bg-light' : 'bg-white');
const pathname = Astro.url.pathname;
const container = 'mx-auto max-w-7xl px-6 lg:px-8';
const meetingLabel = bookingLabel(locale);
const meetingHref = meetingUrl(locale);

const all = await getCollection('insights');
const related = insights.keys
  .map((key) => all.find((e) => e.data.lang === locale && e.data.translationKey === key))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
const insightsBase = locale === 'fr' ? '/fr/perspectives/' : '/en/insights/';

// Image de partage propre au service et à la langue (public/assets/og/)
const shareImage = `/assets/og/${segment === 'pme' ? (locale === 'fr' ? 'og-pme-fr' : 'og-sme-en') : `og-finance-${locale}`}.jpg`;
---

<Layout locale={locale} title={title} description={description} meeting={segment} image={shareImage}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- HÉROS -->
  <section class="relative overflow-hidden bg-teal-deep">
    <ChevronLines class="h-[112px] w-[168px] lg:h-[200px] lg:w-[300px] xl:h-[300px] xl:w-[450px]" />
    <div class={`relative ${container} pt-20 pb-28 lg:py-28`}>
      <p class="home-kicker text-coral">{hero.kicker}</p>
      <h1 class="home-h1">{hero.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-light/85">{hero.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ContactCta href={meetingHref} label={meetingLabel} className="btn" fathomEventName={fathomEvent('ScheduleMeeting', 'Hero', locale, pathname)} />
        <a class="btn btn--outline" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>
  </section>

  <!-- ENJEUX -->
  <section class="bg-light py-20 text-ink" id={issues.id}>
    <div class={container}>
      <h2 class="home-h2">{issues.title}</h2>
      {issues.audience && <p class="mt-4 max-w-3xl text-lg leading-relaxed">{issues.audience}</p>}
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {issues.items.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6">
            {item.icon && <Icon name={item.icon} size={28} class="mb-4 text-teal" />}
            <h3 class="home-h3">{item.title}</h3>
            <p class="mt-3 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- OFFRE D'ENTRÉE -->
  <section class="bg-white py-20 text-ink" id={offer.id}>
    <div class={container}>
      <p class="home-kicker text-teal">{offer.kicker}</p>
      <h2 class="home-h2">{offer.title}</h2>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed">{offer.lead}</p>
      <p class="mt-4 font-semibold text-teal">{offer.price}</p>
      {offer.essor && <EssorPriceNote locale={locale} href="#essor" />}
      <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {offer.items.map((item) => (
          <div class="flex gap-4">
            <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-light text-teal">
              {item.icon && <Icon name={item.icon} size={22} />}
            </span>
            <div>
              <h3 class="home-h3">{item.title}</h3>
              <p class="mt-2 leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <ContactCta href={meetingHref} label={meetingLabel} className="btn" fathomEventName={fathomEvent('ScheduleMeeting', 'Offer', locale, pathname)} />
      </div>
    </div>
  </section>

  <!-- SOLUTIONS LOGICIELLES SUR MESURE -->
  {solutions && (
    <section class="bg-light py-20 text-ink" id={solutions.id}>
      <div class={container}>
        <p class="home-kicker text-teal">{solutions.kicker}</p>
        <h2 class="home-h2">{solutions.title}</h2>
        <p class="mt-3 max-w-3xl text-lg font-semibold leading-relaxed text-teal">{solutions.subtitle}</p>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed">{solutions.promise}</p>
        <p class="mt-4 font-semibold text-teal">{solutions.price}</p>

        <div class="mt-14"><h3 class="offer-h3">{solutions.ai.title}</h3></div>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {solutions.ai.items.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6">
              {item.icon && <Icon name={item.icon} size={28} class="text-teal" />}
              <h4 class="home-h3 mt-4">{item.title}</h4>
              <p class="mt-2 leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>

        <div class="mt-14"><h3 class="offer-h3">{solutions.examples.title}</h3></div>
        <div class="mt-6 grid gap-x-10 gap-y-8 md:grid-cols-2">
          {solutions.examples.items.map((item) => (
            <div class="flex gap-4">
              <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-teal">
                {item.icon && <Icon name={item.icon} size={22} />}
              </span>
              <div>
                <h4 class="home-h3">{item.title}</h4>
                <p class="mt-2 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-14"><h3 class="offer-h3">{solutions.included.title}</h3></div>
        <div class="mt-6 grid gap-x-10 gap-y-8 md:grid-cols-2">
          {solutions.included.items.map((item) => (
            <div class="flex gap-4">
              <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-teal">
                {item.icon && <Icon name={item.icon} size={22} />}
              </span>
              <div>
                <h4 class="home-h3">{item.title}</h4>
                <p class="mt-2 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-14"><h3 class="offer-h3">{solutions.disciplines.title}</h3></div>
        <p class="mt-3 max-w-3xl leading-relaxed">{solutions.disciplines.intro}</p>
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {solutions.disciplines.items.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6">
              {item.icon && <Icon name={item.icon} size={28} class="text-teal" />}
              <h4 class="home-h3 mt-4">{item.title}</h4>
              <p class="mt-2 leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-[1.2fr_1fr]">
          <div>
            <h3 class="offer-h3">{solutions.limits.title}</h3>
            <ul class="mt-4 space-y-3">
              {solutions.limits.items.map((line) => (
                <li class="flex gap-3 leading-relaxed">
                  <span class="mt-2.5 h-px w-4 shrink-0 bg-coral" aria-hidden="true"></span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </div>
          <aside class="self-start rounded-2xl border border-slate-200 border-l-4 border-l-coral bg-white p-6">
            <p class="leading-relaxed">{solutions.strategy.text}</p>
            <a class="mt-3 inline-block font-semibold text-teal underline underline-offset-4" href={solutions.strategy.link.href}>{solutions.strategy.link.label}</a>
          </aside>
        </div>

        <div class="mt-10">
          <ContactCta href={meetingHref} label={meetingLabel} className="btn" fathomEventName={fathomEvent('ScheduleMeeting', 'Solutions', locale, pathname)} />
        </div>
      </div>
    </section>
  )}

  <!-- DÉMARCHE PAR ÉTAPES -->
  {path && (
    <section class={`${shade(0)} py-20 text-ink`} id={path.id}>
      <div class={container}>
        <h2 class="home-h2">{path.title}</h2>
        <p class="mt-4 max-w-3xl leading-relaxed">{path.intro}</p>
        <ol class={`mt-10 grid gap-4 ${path.steps.length === 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3'}`}>
          {path.steps.map((step, index) => (
            <li class="rounded-2xl border border-slate-200 bg-white p-6">
              <p class="font-bold tracking-[0.12em] text-teal">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="home-h3 mt-2">{step.title}</h3>
              {step.meta && <p class="mt-1 text-sm font-semibold text-teal">{step.meta}</p>}
              <p class="mt-2 leading-relaxed">{step.text}</p>
            </li>
          ))}
        </ol>
        {note && (
          <aside class={`mt-8 max-w-4xl rounded-2xl border border-slate-200 border-l-4 border-l-coral ${shade(0) === 'bg-white' ? 'bg-light' : 'bg-white'} p-6`} aria-label={note.title} id={note.id}>
            <p class="home-h3">{note.title}</p>
            <p class="mt-2 leading-relaxed">{note.text}</p>
          </aside>
        )}
      </div>
    </section>
  )}

  <!-- MANDATS CIBLÉS OU EXPERTISE -->
  <section class={`${shade(path ? 1 : 0)} py-20 text-ink`} id={expertise.id}>
    <div class={container}>
      {expertise.kicker && <p class="home-kicker text-teal">{expertise.kicker}</p>}
      <h2 class="home-h2">{expertise.title}</h2>
      <div class={`mt-10 grid gap-4 ${expertise.numbered ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
        {expertise.items.map((item, index) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6">
            <div class="flex items-center justify-between text-teal">
              {item.icon && <Icon name={item.icon} size={28} />}
              {expertise.numbered && <span class="font-bold tracking-[0.12em]">{String(index + 1).padStart(2, '0')}</span>}
            </div>
            <h3 class="home-h3 mt-4">{item.title}</h3>
            <p class="mt-2 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ANALYSES LIÉES -->
  {related.length > 0 && (
    <section class={`${shade(path ? 2 : 1)} py-20 text-ink`} id="perspectives">
      <div class={container}>
        <h2 class="home-h2">{insights.title}</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-2">
          {related.map((entry) => (
            <InsightCard
              entry={entry}
              href={`${insightsBase}${entry.id.replace(/^(fr|en)\//, '')}/`}
              locale={locale}
              segments={articleSegments(entry, all)}
              headingLevel={3}
            />
          ))}
        </div>
        <a class="btn btn--outline-teal mt-8" href={insightsBase}>{insights.allLabel}</a>
      </div>
    </section>
  )}

  <!-- NEUTRALITÉ -->
  <section class={`${shade(path ? 3 : 2)} py-20 text-ink`} id={neutrality.id}>
    <div class={container}>
      <div class="rounded-2xl bg-teal p-6 text-light md:p-8">
        <p class="text-lg font-semibold">{neutrality.title}</p>
        <p class="mt-2 max-w-4xl text-light/90">{neutrality.text}</p>
        <p class="mt-3 max-w-4xl text-light/90">{neutrality.delivery}</p>
      </div>

      <!-- AUTRE SEGMENT -->
      <div class="mt-12 flex flex-col gap-4 border-t border-slate-200 pt-10 lg:flex-row lg:items-center lg:justify-between" id={other.id}>
        <p class="home-h3">{other.question}</p>
        <a class="shrink-0 font-semibold text-teal underline underline-offset-4" href={other.href}>{other.label}</a>
      </div>
    </div>
  </section>
</Layout>
