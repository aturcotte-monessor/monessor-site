---
import { meetingEvent } from '../utils/tracking';

interface Props {
  href: string;
  label: string;
  ariaLabel?: string;
  className?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  label,
  ariaLabel,
  className = 'btn btn--outline',
  target = '_blank',
  rel = 'noopener noreferrer'
} = Astro.props;

const newTab = target === '_blank' ? (Astro.currentLocale === 'en' ? ' (opens in a new tab)' : ' (nouvel onglet)') : '';
// Le clic est compté par l'écouteur délégué de public/scripts/main.js ; le canal vient de la page du clic.
const fathomEventName = meetingEvent(Astro.url.pathname);
---

<a
  class={className}
  href={href}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
  data-fathom-event={fathomEventName}
>
  {label}{newTab && <span class="sr-only">{newTab}</span>}
</a>
