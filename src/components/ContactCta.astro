---
interface Props {
  href: string;
  label: string;
  ariaLabel?: string;
  className?: string;
  target?: string;
  rel?: string;
  fathomEventName?: string;
}

const {
  href,
  label,
  ariaLabel = label,
  className = 'btn btn--outline',
  target = '_blank',
  rel = 'noopener noreferrer',
  fathomEventName = 'Click CTA Contact - Home'
} = Astro.props;

const onClickHandler = `(function (event) {
  try {
    if (window.fathom && typeof window.fathom.trackEvent === 'function') {
      window.fathom.trackEvent('${fathomEventName}');
    }
  } catch (error) {
    console.warn('Fathom event failed:', error);
  }

  if (event.currentTarget.getAttribute('target') === '_blank') {
    event.preventDefault();
    window.open(event.currentTarget.href, '_blank', 'noopener,noreferrer');
  }
})(event);`;
---

<a
  class={className}
  href={href}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
  onclick={onClickHandler}
>
  {label}
</a>
