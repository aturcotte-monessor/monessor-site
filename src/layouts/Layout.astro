---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MeetingCta, { type MeetingVariant } from '../components/MeetingCta.astro';
import { getAlternatePath } from '../utils/i18nRoutes';
import { PERSON_ID } from '../utils/tracking';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: 'fr' | 'en';
  switchHref?: string;
  /** Image de partage 1200×630 ; par défaut, celle de la langue (public/assets/og/). */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  /** Vignette de rendez-vous avant le pied de page ; `false` si la page la place elle-même ou n'en veut pas (404). */
  meeting?: MeetingVariant | false;
  /** Ancre de la vignette (l'accueil utilise `contact`). */
  meetingId?: string;
  noindex?: boolean;
}

const { title, description, locale = 'fr', switchHref, image = `/assets/og/og-${locale}.jpg`, imageAlt, ogType = 'website', ogTitle = title, meeting = 'generic', meetingId, noindex = false } = Astro.props;

const siteUrl = 'https://www.monessor.com';
const pathname = Astro.url.pathname;

// Calcul dynamique des URLs Canoniques et Hreflang
const canonicalUrl = new URL(pathname, siteUrl).href;
// Page 404 : Vercel la sert à l'adresse demandée. Sans canonical ni hreflang, Fathom (qui suit le canonical
// par défaut) enregistre cette adresse réelle au lieu de « /404/ ».
const isNotFound = /^\/(en\/)?404\/?$/.test(pathname);

const isEnPath = pathname.startsWith('/en/');
const frPath = isEnPath ? await getAlternatePath(pathname, 'fr') : pathname;
const enPath = isEnPath ? pathname : await getAlternatePath(pathname, 'en');

const urlFR = new URL(frPath, siteUrl).href;
const urlEN = new URL(enPath, siteUrl).href;
// x-default : la racine pour l'accueil (elle redirige selon la langue du navigateur), sinon la version française
const urlDefault = frPath === '/fr/' ? new URL('/', siteUrl).href : urlFR;
const absoluteImageUrl = new URL(image, siteUrl).href;
const ogImageAlt = imageAlt ?? (locale === 'fr' ? 'Monessor, conseil en gestion stratégique des TI' : 'Monessor, strategic IT management advisory');

// Données structurées JSON-LD pour l'entité Monessor
// Même @id sur toutes les pages : les autres blocs (Service, BlogPosting) y renvoient.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organisation`,
  "name": "Monessor",
  "legalName": "Services-conseils Monessor inc.",
  "url": siteUrl,
  "logo": `${siteUrl}/assets/monessor-logo.png`,
  "image": new URL(`/assets/og/og-${locale}.jpg`, siteUrl).href,
  "description": locale === 'fr'
    ? "Conseil en gestion stratégique des TI pour les PME et les services financiers réglementés."
    : "Strategic IT management advisory for SMEs and regulated financial services.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Montréal",
    "addressRegion": "QC",
    "addressCountry": "CA"
  },
  "areaServed": [{ "@type": "AdministrativeArea", "name": "Québec" }, { "@type": "Country", "name": "Canada" }],
  "founder": {
    "@type": "Person",
    "@id": PERSON_ID,
    "name": "Alex Turcotte",
    "jobTitle": locale === 'fr' ? "Associé directeur" : "Managing Partner",
    "url": new URL(locale === 'fr' ? '/fr/a-propos/' : '/en/about/', siteUrl).href,
    "sameAs": ["https://www.linkedin.com/in/turcottealex", "https://www.alexturcotte.ca/"]
  },
  "sameAs": ["https://www.linkedin.com/in/turcottealex"],
  "knowsLanguage": ["fr", "en"]
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    
    <!-- Canonical -->
    {!isNotFound && <link rel="canonical" href={canonicalUrl} />}

    <!-- Dynamic Hreflang Tags -->
    {!isNotFound && (
      <>
        <link rel="alternate" hreflang="fr" href={urlFR} />
        <link rel="alternate" hreflang="en" href={urlEN} />
        <link rel="alternate" hreflang="x-default" href={urlDefault} />
      </>
    )}

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Monessor" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:locale:alternate" content={locale === 'fr' ? 'en_CA' : 'fr_CA'} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preload" href="/fonts/inter-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-wordmark-700.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <!-- Fathom Analytics -->
    <script
      is:inline
      src="https://cdn.usefathom.com/script.js"
      data-site="LRVBMDAF"
      defer>
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#contenu" class="skip-link">{locale === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <Header locale={locale} switchHref={switchHref} />
    <main id="contenu" class="flex-1" tabindex="-1">
      <slot />
      {meeting && <MeetingCta locale={locale} variant={meeting} id={meetingId} />}
    </main>
    <Footer locale={locale} switchHref={switchHref} />
    <script is:inline src="/scripts/main.js"></script>
    <slot name="scripts" />
  </body>
</html>