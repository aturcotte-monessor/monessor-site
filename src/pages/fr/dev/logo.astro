---
// Page de travail TEMPORAIRE (non indexée, hors sitemap) : choix de la graisse Montserrat du mot MONESSOR.
// À supprimer avant la fusion du lot 6, avec public/dev/ et la police Montserrat si elle n'est pas retenue.
import Layout from '../../../layouts/Layout.astro';

// Interlettrage calé sur la largeur totale du mot d'origine (largeur / hauteur de capitale = 7,82)
const variants = [
  { weight: 700, label: 'Montserrat Bold (700)', tracking: '-0.05em' },
  { weight: 800, label: 'Montserrat ExtraBold (800)', tracking: '-0.056em' }
];
---

<Layout title="Mot MONESSOR : comparaison | Monessor" description="Page de travail." locale="fr" meeting={false} noindex>
  <style is:global>
    @font-face {
      font-family: "Montserrat";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("/fonts/montserrat-latin-wght.woff2") format("woff2");
    }
    .mont { font-family: "Montserrat", sans-serif; line-height: 1; }
  </style>

  <section class="bg-light py-12 text-ink">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h1 class="home-h2">Mot MONESSOR : Bold ou ExtraBold ?</h1>
      <p class="mt-3 max-w-3xl">Page de travail temporaire, non indexée. Elle sera retirée avant la fusion.</p>

      <h2 class="home-h3 mt-10">Logo d'origine (image Gemini, 304 px agrandie)</h2>
      <div class="mt-4 inline-block rounded-2xl border border-slate-200 bg-white p-6">
        <img src="/dev/monessor-logo-full.png" alt="Logo d'origine Monessor" width="304" height="314" class="h-auto w-[300px] sm:w-[480px]" />
      </div>

      <h2 class="home-h3 mt-12">Mesures sur le logo d'origine</h2>
      <ul class="mt-3 list-disc space-y-1 pl-6">
        <li>Épaisseur du trait vertical / hauteur de capitale : 0,21 (origine), 0,21 à 0,22 (700), 0,25 à 0,27 (800).</li>
        <li>Largeur du mot / hauteur de capitale : 7,82 (origine), 8,30 (700) et 8,36 (800) sans interlettrage ; calé ici sur l'origine.</li>
        <li>Les lettres d'origine sont environ 7 % plus étroites que celles de Montserrat ; l'espace entre les lettres est presque identique.</li>
      </ul>
    </div>
  </section>

  {variants.map((v) => (
    <section class="border-t border-slate-200">
      <div class="bg-white py-10">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <h2 class="home-h3">{v.label}, interlettrage {v.tracking}</h2>
          <div class="mt-6 flex items-center gap-4">
            <img src="/assets/monessor-embleme.svg" alt="" width="64" height="66" class="h-[66px] w-[64px]" />
            <span class="mont text-[44px] text-teal sm:text-[64px]" style={`font-weight:${v.weight};letter-spacing:${v.tracking}`}>MONESSOR</span>
          </div>
          <p class="mt-6 text-sm text-slate-600">Taille réelle de l'en-tête :</p>
          <div class="mt-2 flex items-center gap-3">
            <img src="/assets/monessor-embleme.svg" alt="" width="34" height="35" class="h-[35px] w-[34px]" />
            <span class="mont text-lg text-teal" style={`font-weight:${v.weight};letter-spacing:${v.tracking}`}>MONESSOR</span>
            <span class="mx-6 text-slate-400">|</span>
            <span class="text-sm text-slate-600">avec l'interlettrage actuel de l'en-tête (0,08em) :</span>
            <img src="/assets/monessor-embleme.svg" alt="" width="34" height="35" class="h-[35px] w-[34px]" />
            <span class="mont text-lg text-teal" style={`font-weight:${v.weight};letter-spacing:0.08em`}>MONESSOR</span>
          </div>
        </div>
      </div>
      <div class="bg-teal-deep py-10">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="flex items-center gap-4">
            <img src="/assets/monessor-embleme-blanc-corail.svg" alt="" width="64" height="66" class="h-[66px] w-[64px]" />
            <span class="mont text-[44px] text-light sm:text-[64px]" style={`font-weight:${v.weight};letter-spacing:${v.tracking}`}>MONESSOR</span>
          </div>
          <div class="mt-6 flex items-center gap-3">
            <img src="/assets/monessor-embleme-blanc-corail.svg" alt="" width="34" height="35" class="h-[35px] w-[34px]" />
            <span class="mont text-lg text-light" style={`font-weight:${v.weight};letter-spacing:0.08em`}>MONESSOR</span>
          </div>
        </div>
      </div>
    </section>
  ))}
</Layout>
