---
import ServicePage from '../../../components/ServicePage.astro';

const url = 'https://www.monessor.com/fr/services/services-financiers-reglementes/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Revue de gouvernance TI et conformité BSIF',
  serviceType: 'Gouvernance TI et conformité réglementaire',
  url,
  provider: { '@type': 'ProfessionalService', name: 'Monessor', url: 'https://www.monessor.com' },
  areaServed: { '@type': 'Country', name: 'Canada' },
  audience: { '@type': 'BusinessAudience', name: 'Institutions financières et FinTechs' },
  availableLanguage: ['fr', 'en'],
  offers: {
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: 'Revue de gouvernance TI et conformité BSIF' },
    description: 'Forfait à périmètre fixe, tarif sur demande.'
  }
};
---

<ServicePage
  locale="fr"
  segment="sf"
  title="Gouvernance TI et conformité BSIF | Monessor"
  description="Revue de gouvernance TI pour institutions financières et FinTechs : risque lié aux tiers (B-10), risques technologiques (B-13), risque de modélisation (E-23)."
  jsonLd={jsonLd}
  hero={{
    kicker: 'Gouvernance TI, risques et conformité · Services financiers',
    title: 'Respectez la rigueur réglementaire sans freiner l’innovation de vos plateformes.',
    lead: 'Monessor conçoit et valide des cadres de gouvernance TI alignés sur les lignes directrices du BSIF (gestion du risque lié aux tiers, B-10 ; gestion des risques technologiques et du cyberrisque, B-13 ; gestion du risque de modélisation, E-23) pour les institutions financières et les FinTechs en croissance.',
    secondary: { label: 'Voir la Revue', href: '#revue' }
  }}
  issues={{
    id: 'enjeux',
    title: 'Là où la gouvernance traditionnelle freine l’exécution',
    items: [
      {
        icon: 'shield-check',
        title: 'Des exigences du BSIF de plus en plus lourdes',
        text: 'Une complexité croissante pour se conformer aux attentes en matière de risques technologiques et de cyberrisque (B-13), de résilience opérationnelle et de gestion du risque lié aux tiers (B-10).'
      },
      {
        icon: 'file-text',
        title: 'L’illusion de la conformité « sur papier »',
        text: 'Des politiques rédigées pour les auditeurs, mais déconnectées du code déployé en production par les équipes et les fournisseurs infonuagiques.'
      },
      {
        icon: 'brain-circuit',
        title: 'Le risque de modélisation et l’IA (E-23)',
        text: 'Encadrer les algorithmes et les modèles décisionnels automatisés sans ralentir le développement des produits numériques.'
      },
      {
        icon: 'scale',
        title: 'La friction entre risque et livraison',
        text: 'Des comités de validation lourds qui allongent les délais de mise en marché et créent des tensions entre la gestion des risques, la conformité et les équipes produit.'
      }
    ]
  }}
  offer={{
    id: 'revue',
    kicker: 'Point de départ',
    title: 'Revue de gouvernance TI et conformité BSIF',
    lead: 'Un mandat de 3 à 4 semaines pour évaluer votre conformité technologique, repérer les failles liées aux tiers et remettre une matrice de remédiation directement utilisable par votre comité de risques et d’audit.',
    price: 'Forfait à périmètre fixe, tarif sur demande.',
    items: [
      {
        icon: 'search-check',
        title: 'Analyse des écarts (B-10 et B-13)',
        text: 'Une évaluation concrète de l’alignement de votre infrastructure et de vos politiques sur les attentes du BSIF.'
      },
      {
        icon: 'handshake',
        title: 'Évaluation du risque lié aux tiers',
        text: 'Les dépendances technologiques critiques, les contrats fournisseurs et les plans de continuité des affaires.'
      },
      {
        icon: 'brain-circuit',
        title: 'Cadre de gestion du risque de modélisation (E-23)',
        text: 'Des garde-fous d’architecture et des mécanismes d’explicabilité pour l’utilisation de modèles et de l’IA en contexte réglementé.'
      },
      {
        icon: 'list-checks',
        title: 'Matrice de remédiation et plan d’action',
        text: 'Une feuille de route priorisée par niveau de risque, pour répondre aux attentes des auditeurs et des autorités de réglementation.'
      }
    ]
  }}
  expertise={{
    id: 'approche',
    title: 'Une expertise pour les environnements à haut risque',
    numbered: true,
    items: [
      {
        icon: 'layers',
        title: 'Conformité dès la conception',
        text: 'Les contraintes réglementaires intégrées directement aux pipelines de déploiement (CI/CD) et aux architectures infonuagiques, sans ralentir les développeurs.'
      },
      {
        icon: 'shield-check',
        title: 'Accompagnement lors des audits',
        text: 'Une présence aux côtés de la direction lors des audits internes et externes et des inspections des autorités de réglementation.'
      },
      {
        icon: 'brain-circuit',
        title: 'Gouvernance des modèles et IA responsable',
        text: 'L’encadrement du cycle de vie des modèles prédictifs et génératifs, pour en garantir l’auditabilité et la sécurité.'
      }
    ]
  }}
  insights={{ title: 'Analyses liées', keys: ['governance-speed', 'replatforming-fable'], allLabel: 'Explorer toutes les analyses' }}
  neutrality={{
    id: 'neutralite',
    title: 'Une rigueur d’ingénierie, pas seulement un avis juridique.',
    text: 'Monessor n’est ni un cabinet d’avocats ni un cabinet d’audit comptable. Elle combine une compréhension approfondie des attentes du BSIF et une expertise en architecture logicielle pour rendre vos systèmes réellement conformes sur le terrain, et pas seulement sur papier.',
    delivery: 'Chaque mandat est dirigé personnellement par Alex Turcotte, associé directeur. Lorsqu’un mandat exige une expertise très pointue, Monessor fait appel à un spécialiste de son réseau.'
  }}
  other={{
    id: 'pme-etablies',
    question: 'Vous dirigez une PME?',
    label: 'Découvrir le Diagnostic de maturité TI →',
    href: '/fr/services/pme/'
  }}
/>
