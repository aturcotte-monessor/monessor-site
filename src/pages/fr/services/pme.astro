---
import ServicePage from '../../../components/ServicePage.astro';

const url = 'https://www.monessor.com/fr/services/pme/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Conseil en gestion stratégique des TI pour PME',
  serviceType: 'Conseil en gestion stratégique des TI',
  url,
  provider: { '@type': 'ProfessionalService', name: 'Monessor', url: 'https://www.monessor.com' },
  areaServed: { '@type': 'Country', name: 'Canada' },
  availableLanguage: ['fr', 'en'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Offres aux PME',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Diagnostic de maturité TI et alignement IA' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 12500, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Sélection et arbitrage des fournisseurs' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Direction TI à temps partagé' },
        priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 8000, priceCurrency: 'CAD', unitText: 'mois' }
      }
    ]
  }
};
---

<ServicePage
  locale="fr"
  segment="pme"
  title="Diagnostic de maturité TI et direction TI pour PME | Monessor"
  description="Diagnostic de maturité TI de 2 à 3 semaines, dès 12 500 $, pour les PME. Puis livrables ciblés et direction TI à temps partagé."
  jsonLd={jsonLd}
  hero={{
    kicker: 'Conseil en gestion stratégique des TI · PME',
    title: 'Reprenez le contrôle de vos investissements technologiques.',
    lead: 'Monessor aide les dirigeants de PME à réduire la dette technique, à arbitrer les projets critiques et à encadrer l’intelligence artificielle avec la rigueur de gouvernance du secteur financier réglementé. Nos clients réalisent le plus souvent entre 5 et 100 millions de dollars de chiffre d’affaires, dans la fabrication, la distribution ou les services.',
    secondary: { label: 'Voir le Diagnostic', href: '#diagnostic' }
  }}
  issues={{
    id: 'symptomes',
    title: 'Là où la technologie cesse d’être un levier et devient un risque',
    items: [
      {
        icon: 'wallet',
        title: 'Des projets qui dérapent et des coûts sans contrôle',
        text: 'Des budgets TI et des factures d’infrastructure qui augmentent chaque année sans visibilité sur le rendement, et des livraisons stratégiques sans cesse retardées.'
      },
      {
        icon: 'server-cog',
        title: 'Une dette technique et des dépendances critiques',
        text: 'Des systèmes centraux (ERP, CRM, applications maison) complexes et vulnérables, maintenus par quelques personnes clés ou un seul fournisseur, sans solution de rechange.'
      },
      {
        icon: 'brain-circuit',
        title: 'L’IA sous pression, sans cas d’affaires',
        text: 'Une pression pour intégrer l’intelligence artificielle sans rendement mesurable, au risque de dépenser beaucoup sans créer de valeur opérationnelle.'
      },
      {
        icon: 'scale',
        title: 'Un dialogue difficile entre finance et TI',
        text: 'Une direction financière attentive aux marges et au bilan, face à des équipes techniques absorbées par les urgences du quotidien.'
      }
    ]
  }}
  offer={{
    id: 'diagnostic',
    kicker: 'Point de départ',
    title: 'Diagnostic de maturité TI et alignement IA',
    lead: 'Un mandat de 2 à 3 semaines qui donne à votre comité de direction et à votre conseil d’administration une vision complète de l’état, des risques et du potentiel de vos technologies.',
    price: 'Dès 12 500 $, forfait à périmètre fixe.',
    items: [
      {
        icon: 'layers',
        title: 'Revue de l’architecture et de la dette technique',
        text: 'Examen indépendant de la stabilité des systèmes centraux, des risques de défaillance et du coût total de possession.'
      },
      {
        icon: 'brain-circuit',
        title: 'Matrice des cas d’usage de l’IA',
        text: 'Les processus automatisables à court terme, chacun avec son rendement financier estimé, plutôt que des projets à la mode.'
      },
      {
        icon: 'handshake',
        title: 'Revue de la gouvernance et des contrats fournisseurs',
        text: 'Un regard indépendant sur les soumissions, les coûts d’infonuagique et les dépendances envers vos fournisseurs, en vue de les renégocier.'
      },
      {
        icon: 'map',
        title: 'Feuille de route sur 18 mois',
        text: 'Un plan clair, priorisé et chiffré, prêt à être présenté à votre conseil d’administration.'
      }
    ]
  }}
  path={{
    id: 'approche',
    title: 'Après le diagnostic : une démarche par étapes',
    intro: 'Le diagnostic fixe la direction. Deux ou trois livrables ciblés produisent les premiers résultats. La direction TI à temps partagé en est la suite naturelle, une fois la confiance établie.',
    steps: [
      {
        title: 'Diagnostic de maturité TI',
        meta: '2 à 3 semaines · dès 12 500 $',
        text: 'L’état des lieux, la dette technique, les risques et la feuille de route.'
      },
      {
        title: 'Sélection et arbitrage des fournisseurs',
        meta: '4 à 8 semaines · dès 15 000 $',
        text: 'Cahier des charges neutre, conduite de l’appel d’offres, choix objectif et négociation, sans conflit d’intérêts.'
      },
      {
        title: 'Direction TI à temps partagé',
        meta: 'Mensuel · dès 8 000 $ par mois',
        text: 'Une présence au comité de direction, environ une journée par semaine, pour piloter l’exécution, encadrer les équipes et rendre compte au conseil.'
      }
    ]
  }}
  note={{
    title: 'Aide financière possible',
    text: 'Selon le projet, un diagnostic numérique, une sélection de systèmes ou la mise en œuvre d’un plan numérique peut être admissible au programme ESSOR d’Investissement Québec, qui rembourse jusqu’à 50 % des dépenses admissibles. La demande doit être déposée avant le début du mandat, l’acceptation n’est pas garantie et le programme prend fin le 31 mars 2027. Nous pouvons vous aider à évaluer si votre projet s’y prête.'
  }}
  expertise={{
    id: 'expertise-complementaire',
    title: 'Mandats ciblés et situations critiques',
    items: [
      {
        icon: 'list-checks',
        title: 'Choix et arbitrage d’un logiciel central (ERP, CRM)',
        text: 'Analyse neutre de vos besoins, cahier des charges, conduite de l’appel d’offres et négociation, à l’abri de la pression des revendeurs.'
      },
      {
        icon: 'brain-circuit',
        title: 'Sélection indépendante de partenaires en IA',
        text: 'Évaluation de la maturité de vos données et des cas d’usage à fort rendement, pour retenir les bons partenaires sans céder aux promesses irréalistes.'
      },
      {
        icon: 'search-check',
        title: 'Audit technologique transactionnel (vente, acquisition, relève)',
        text: 'Évaluation de la valeur réelle des actifs numériques, de la stabilité des systèmes et de la dette technique, pour sécuriser la transaction.'
      },
      {
        icon: 'key-round',
        title: 'Reprise de contrôle face à la dépendance technologique',
        text: 'Récupération des accès, du code source et des données, pour préserver votre liberté de choix face à vos fournisseurs.'
      }
    ]
  }}
  insights={{ title: 'Analyses liées', keys: ['sme-technology-strategy', 'replatforming-fable'], allLabel: 'Explorer toutes les analyses' }}
  neutrality={{
    id: 'neutralite',
    title: 'Zéro commission. Zéro revente de licences. Entièrement de votre côté de la table.',
    text: 'Monessor n’est ni une agence de développement, ni un revendeur de logiciels (SaaS, ERP), ni un sous-traitant d’ingénierie. Aucune commission de fournisseur : sa seule rémunération vient de ses clients, et ses recommandations n’ont pas d’autre intérêt que le vôtre.',
    delivery: 'Chaque mandat est dirigé personnellement par Alex Turcotte, associé directeur. Lorsqu’un mandat exige une expertise très pointue, Monessor fait appel à un spécialiste de son réseau.'
  }}
  other={{
    id: 'secteurs-regules',
    question: 'Vous êtes une institution financière ou une FinTech?',
    label: 'Découvrir la Revue de gouvernance TI →',
    href: '/fr/services/finance-reglementee/'
  }}
/>
