---
import ServicePage from '../../../components/ServicePage.astro';

const url = 'https://www.monessor.com/fr/services/pme/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Conseil en gestion stratégique des TI pour PME',
  serviceType: 'Conseil en gestion stratégique des TI',
  url,
  provider: { '@id': 'https://www.monessor.com/#organisation' },
  areaServed: { '@type': 'Country', name: 'Canada' },
  availableLanguage: ['fr', 'en'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Offres aux PME',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Coup de sonde TI' },
        price: 1500,
        priceCurrency: 'CAD'
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Bilan de santé TI' },
        price: 4500,
        priceCurrency: 'CAD'
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Audit TI complet' },
        price: 23750,
        priceCurrency: 'CAD'
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Solutions logicielles sur mesure' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Sélection et arbitrage des fournisseurs' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Direction TI à temps partagé' },
        priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 8000, priceCurrency: 'CAD', unitText: 'mois' }
      }
    ]
  }
};
---

<ServicePage
  locale="fr"
  segment="pme"
  title="Bilan de santé TI, audit TI et direction TI pour PME | Monessor"
  description="Pour les PME : Bilan de santé TI à 4 500 $, audit numérique complet de vos TI à 23 750 $, solutions logicielles sur mesure développées avec l’IA dès 15 000 $, direction TI à temps partagé."
  jsonLd={jsonLd}
  hero={{
    kicker: 'Conseil en gestion stratégique des TI · PME',
    title: 'Reprenez le contrôle de vos investissements technologiques.',
    lead: 'Monessor vous aide à moderniser des systèmes vieillissants, à choisir les bons projets, à encadrer l’intelligence artificielle et à en tirer profit, et à livrer des outils sur mesure, avec pragmatisme et rigueur. Nos clients sont surtout dans la fabrication, la distribution ou les services.',
    secondary: { label: 'Par où commencer', href: '#diagnostic' }
  }}
  issues={{
    id: 'symptomes',
    title: 'Là où la technologie cesse d’être un levier et devient un risque',
    audience: 'Le plus souvent des entreprises de 20 à 250 employés.',
    items: [
      {
        icon: 'wallet',
        title: 'Des projets qui dérapent et des coûts sans contrôle',
        text: 'Des budgets TI et des factures d’infrastructure qui augmentent chaque année sans visibilité sur le rendement, et des projets importants sans cesse retardés.'
      },
      {
        icon: 'server-cog',
        title: 'Une dette technique et des dépendances critiques',
        text: 'Des systèmes centraux (ERP, CRM, applications maison) complexes et vulnérables, maintenus par quelques personnes clés ou un seul fournisseur, sans solution de rechange.'
      },
      {
        icon: 'brain-circuit',
        title: 'L’IA sous pression, sans cas d’affaires',
        text: 'Une pression pour intégrer l’intelligence artificielle sans rendement mesurable, au risque de dépenser beaucoup sans créer de valeur opérationnelle.'
      },
      {
        icon: 'scale',
        title: 'Un dialogue difficile entre finance et TI',
        text: 'Une direction financière attentive aux marges et au bilan, face à des équipes techniques absorbées par les urgences du quotidien.'
      },
      {
        icon: 'workflow',
        title: 'Production et inventaire',
        text: 'L’inventaire et les bons de travail vivent dans Excel ou sur papier : les chiffres de production arrivent trop tard pour décider.'
      },
      {
        icon: 'lock',
        title: 'Une cybersécurité jamais mise à l’épreuve',
        text: 'Un rançongiciel arrêterait la production : les sauvegardes et les accès n’ont jamais été testés.'
      }
    ]
  }}
  offer={{
    id: 'diagnostic',
    kicker: 'Point de départ',
    title: 'Deux façons de commencer',
    lead: 'Un premier regard pour savoir où vous en êtes, ou un audit complet pour savoir quoi faire, dans quel ordre et pour quel rendement. Dans les deux cas, nous partons de vos vrais systèmes et de vos vrais contrats, pas d’une autoévaluation.',
    cards: [
      {
        title: 'Bilan de santé TI',
        tagline: 'Le regard d’un expert sur l’ensemble de vos TI, et vos priorités pour les 12 prochains mois.',
        meta: '2 à 3 semaines · une demi-journée de votre temps',
        text: 'Vos cinq risques principaux, trois gains rapides, des pistes d’IA et un ordre de grandeur budgétaire, présentés à votre direction.',
        price: '4 500 $, prix fixe'
      },
      {
        title: 'Audit TI complet',
        tagline: 'Chaque système, contrat et contrôle vérifié, preuves à l’appui, et une feuille de route chiffrée.',
        meta: '4 à 6 semaines',
        text: 'Toutes les fonctions de l’entreprise passées en revue, les contrôles essentiels vérifiés, les usages de l’IA chiffrés et un plan sur 18 mois.',
        price: '23 750 $, prix fixe',
        scope: 'Pour un site, jusqu’à 10 systèmes, 5 entrevues et 2 processus approfondis. Votre situation est différente ? Nous ajustons la portée avant de commencer, jamais en cours de route.'
      }
    ],
    notes: [
      'Vous poursuivez dans les 60 jours ? Le montant payé est déduit de l’étape suivante.',
      'Une question précise ? Le Coup de sonde TI : un atelier de deux heures et une note d’avis, 1 500 $.'
    ],
    itemsTitle: 'Ce que couvre l’Audit TI complet',
    items: [
      {
        icon: 'layers',
        title: 'Vos fonctions, vos processus et l’état réel de vos systèmes',
        text: 'Chaque fonction de l’entreprise, des ventes à la paie, et un examen indépendant de vos systèmes centraux : leur stabilité, les risques de panne et ce qu’ils vous coûtent vraiment, licences, entretien et soutien compris.'
      },
      {
        icon: 'lock',
        title: 'Votre cybersécurité et votre capacité à repartir',
        text: 'Les contrôles qui peuvent arrêter l’entreprise sont vérifiés, pas seulement déclarés : sauvegardes restaurables, authentification à deux facteurs, accès des employés partis et des fournisseurs.'
      },
      {
        icon: 'handshake',
        title: 'Vos contrats, vos fournisseurs et vos coûts',
        text: 'Un regard indépendant sur vos contrats, vos licences et vos coûts d’infonuagique, avec les dépendances à réduire et les pistes de renégociation.'
      },
      {
        icon: 'map',
        title: 'L’IA et un plan chiffré sur 18 mois',
        text: 'Les usages de l’IA et de l’automatisation les plus rentables, chacun avec son rendement estimé, puis un plan priorisé : où investir, dans quel ordre, et comment accompagner vos équipes dans le changement.'
      }
    ]
  }}
  solutions={{
    id: 'solutions',
    kicker: 'Un premier gain concret',
    title: 'Solutions logicielles sur mesure',
    subtitle: 'Développées avec l’IA, livrées avec toutes les expertises d’un vrai produit logiciel.',
    promise: 'Un outil sur mesure qui règle un point de friction précis, livré en quelques semaines avec la rigueur d’un produit logiciel.',
    price: 'Dès 15 000 $, à prix fixe, en 2 à 6 semaines.',
    ai: {
      title: 'L’IA, à deux niveaux',
      items: [
        {
          icon: 'brain-circuit',
          title: 'Dans l’outil',
          text: 'L’outil peut lire des factures, classer des documents, normaliser des données ou répondre aux questions sur les données de votre entreprise.'
        },
        {
          icon: 'rocket',
          title: 'Pour le construire',
          text: 'L’IA accélère le développement, ce qui rend un outil sur mesure abordable pour une PME. La rigueur d’ingénierie garde le résultat fiable et facile à maintenir.'
        }
      ]
    },
    examples: {
      title: 'Exemples',
      items: [
        { icon: 'calculator', title: 'Automatiser une tâche comptable répétitive', text: 'Par exemple, la saisie et le rapprochement des factures fournisseurs.' },
        { icon: 'database', title: 'Préparer vos données pour un ERP ou un CRM', text: 'Nettoyer, normaliser et préparer les données avant leur importation.' },
        { icon: 'wrench', title: 'Créer un petit outil interne', text: 'Pour faire gagner du temps à une équipe, ou distinguer votre entreprise auprès de ses clients.' },
        { icon: 'puzzle', title: 'Ajouter une extension à votre ERP ou CRM', text: 'Par exemple, un calcul de soumission ou un rapport qui manque.' },
        { icon: 'list-checks', title: 'Fabrication', text: 'Suivre la production, préparer les soumissions ou numériser les bons de travail.' }
      ]
    },
    included: {
      title: 'La rigueur, sans angle mort',
      items: [
        { icon: 'target', title: 'Un gain mesuré avant de coder', text: 'Une courte étape de cadrage de 2 à 3 jours, toujours incluse, précise le point de friction et mesure le gain attendu avant tout développement.' },
        { icon: 'lock', title: 'Sécurité et renseignements personnels dès la conception', text: 'Les accès, les données et la conformité à la Loi 25 sont traités dès le départ, pas après coup.' },
        { icon: 'file-text', title: 'Tests, documentation et transfert', text: 'Le code est testé et documenté, puis remis à votre équipe, avec la possibilité de former des responsables internes.' },
        { icon: 'key-round', title: 'Votre code, vos données', text: 'Le code et les données vous appartiennent et sont hébergés dans votre environnement.' }
      ]
    },
    disciplines: {
      title: 'Toutes les expertises d’un vrai produit logiciel',
      intro: 'Un outil fiable exige plus que du code. Une seule personne responsable couvre ici chacune des expertises :',
      items: [
        { icon: 'layers', title: 'Intégration à vos systèmes', text: 'Architecture de solution : l’outil s’intègre à vos systèmes existants et reste disponible, rapide et sûr à mesure que l’entreprise grandit.' },
        { icon: 'code', title: 'Développement logiciel', text: 'Un code testé, lisible et documenté.' },
        { icon: 'workflow', title: 'Mise en service et suivi', text: 'DevOps : le déploiement, la surveillance et les sauvegardes, dès le premier jour.' },
        { icon: 'users', title: 'Expérience utilisateur', text: 'Par le fondateur du centre d’excellence en expérience utilisateur d’un chef de file des marchés financiers canadiens : un outil que les équipes adoptent.' },
        { icon: 'shield-check', title: 'Gouvernance TI et cybersécurité', text: 'Par un ancien directeur TI : les accès, les données et les risques restent sous contrôle.' }
      ]
    },
    limits: {
      title: 'Cadre et limites',
      items: [
        'Des applications de petite taille : de 2 à 6 semaines, à prix fixe.',
        'Au-delà d’environ 40 000 $ ou de 6 semaines, le mandat est découpé en phases ou confié à un partenaire de développement.',
        'Soutien et maintenance mensuels en option, tarif sur demande.',
        'Formation de responsables internes en option : une ou quelques personnes apprennent à utiliser, à faire évoluer et à maintenir l’outil, et à repérer les prochains gains de l’IA. Le but est votre autonomie, pas votre dépendance. Tarif sur demande, ou inclus dans les plus grands projets.',
        'Monessor ne revend aucun logiciel et ne touche aucune commission : les outils tiers sont choisis pour vous et à votre nom.'
      ]
    },
    strategy: {
      text: 'Votre stratégie IA se définit dans l’Audit TI complet, qui chiffre les usages de l’IA les plus rentables et les place dans un plan priorisé. Cette offre en livre un élément, ou règle directement un point de friction que vous connaissez déjà.',
      link: { label: 'L’Audit TI complet ↑', href: '#diagnostic' }
    }
  }}
  path={{
    id: 'approche',
    title: 'Après le premier regard : une démarche par étapes',
    intro: 'Le Bilan ou l’Audit fixe la direction. Un premier gain concret, outil sur mesure ou sélection de fournisseurs, produit des résultats rapides. La direction TI à temps partagé en est la suite naturelle, une fois la confiance établie.',
    steps: [
      {
        title: 'Bilan de santé TI ou Audit TI complet',
        meta: '2 à 6 semaines · 4 500 $ ou 23 750 $',
        text: 'Le point de départ recommandé : l’état de vos systèmes, les risques, vos priorités et, avec l’Audit, un plan chiffré, IA comprise.'
      },
      {
        title: 'Solutions logicielles sur mesure',
        meta: '2 à 6 semaines · dès 15 000 $',
        text: 'Un outil qui règle un point de friction précis. Il peut aussi servir de point de départ quand le problème est déjà connu.'
      },
      {
        title: 'Sélection et arbitrage des fournisseurs',
        meta: '4 à 8 semaines · dès 15 000 $',
        text: 'Cahier des charges neutre, conduite de l’appel d’offres, choix objectif et négociation, sans conflit d’intérêts.'
      },
      {
        title: 'Direction TI à temps partagé',
        meta: 'Mensuel · dès 8 000 $ par mois',
        text: 'Une présence au comité de direction, environ une journée par semaine, pour piloter l’exécution, encadrer les équipes et vous rendre des comptes.'
      }
    ]
  }}
  note={{
    id: 'essor',
    title: 'Aide financière possible',
    text: 'Le Bilan de santé TI et l’Audit TI complet ne sont pas financés par le programme ESSOR d’Investissement Québec, mais ils peuvent servir à définir un projet qui l’est. Selon le projet, une étude de faisabilité, un diagnostic et plan numérique complet ou la mise en œuvre de ce plan peut être admissible, avec un remboursement jusqu’à 50 % des dépenses admissibles. La demande doit être déposée avant le début du mandat, l’acceptation n’est pas garantie et le programme prend fin le 31 mars 2027. Nous pouvons vous aider à évaluer si votre projet s’y prête.'
  }}
  expertise={{
    id: 'expertise-complementaire',
    title: 'Mandats ciblés et situations critiques',
    items: [
      {
        icon: 'list-checks',
        title: 'Choix et arbitrage d’un logiciel central (ERP, CRM)',
        text: 'Analyse neutre de vos besoins, cahier des charges, conduite de l’appel d’offres et négociation, à l’abri de la pression des revendeurs.'
      },
      {
        icon: 'brain-circuit',
        title: 'Sélection indépendante de partenaires en IA',
        text: 'Évaluation de vos données et des usages de l’IA les plus rentables, pour retenir les bons partenaires sans céder aux promesses irréalistes.'
      },
      {
        icon: 'search-check',
        title: 'Évaluation technologique avant une vente, une acquisition ou une relève',
        text: 'La valeur réelle des actifs numériques, la stabilité des systèmes et ce qu’il faudra réinvestir pour les remettre à niveau, pour sécuriser la transaction.'
      },
      {
        icon: 'key-round',
        title: 'Reprise de contrôle face à la dépendance technologique',
        text: 'Récupération des accès, du code source et des données, pour préserver votre liberté de choix face à vos fournisseurs.'
      }
    ]
  }}
  insights={{ title: 'Analyses liées', keys: ['sme-technology-strategy', 'replatforming-fable'], allLabel: 'Explorer toutes les analyses' }}
  neutrality={{
    id: 'neutralite',
    title: 'Zéro commission. Zéro revente de licences. Entièrement de votre côté de la table.',
    text: 'Monessor ne revend aucun logiciel (SaaS, ERP) et ne touche aucune commission de fournisseur : sa seule rémunération vient de ses clients. Quand il développe, ce sont des outils ciblés, pas des plateformes, dont vous possédez le code ; et l’audit peut tout aussi bien recommander un produit du marché.',
    delivery: 'Chaque mandat est dirigé personnellement par Alex Turcotte, associé directeur. Lorsqu’un mandat exige une expertise très pointue, Monessor fait appel à un spécialiste de son réseau.'
  }}
  other={{
    id: 'secteurs-regules',
    question: 'Vous êtes une institution financière ou une FinTech?',
    label: 'Découvrir la Revue de gouvernance TI →',
    href: '/fr/services/finance-reglementee/'
  }}
/>
