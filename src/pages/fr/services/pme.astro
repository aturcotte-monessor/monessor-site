---
import ServicePage from '../../../components/ServicePage.astro';

const url = 'https://www.monessor.com/fr/services/pme/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Conseil en gestion stratégique des TI pour PME',
  serviceType: 'Conseil en gestion stratégique des TI',
  url,
  provider: { '@id': 'https://www.monessor.com/#organisation' },
  areaServed: { '@type': 'Country', name: 'Canada' },
  availableLanguage: ['fr', 'en'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Offres aux PME',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Diagnostic de maturité TI et alignement IA' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 12500, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Solutions logicielles sur mesure' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Sélection et arbitrage des fournisseurs' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Direction TI à temps partagé' },
        priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 8000, priceCurrency: 'CAD', unitText: 'mois' }
      }
    ]
  }
};
---

<ServicePage
  locale="fr"
  segment="pme"
  title="Diagnostic de maturité TI et direction TI pour PME | Monessor"
  description="Pour les PME : Diagnostic de maturité TI dès 12 500 $, solutions logicielles sur mesure développées avec l’IA dès 15 000 $, direction TI à temps partagé."
  jsonLd={jsonLd}
