---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('insights', ({ id, data }) => id.startsWith('fr/') && data.lang === 'fr')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const toInsightUrl = (id: string) => `/insights/${id.replace(/^fr\//, '').replace(/\.md$/, '')}/`;
---

<Layout
  locale="fr"
  title="Perspectives - Monessor"
  description="Analyses et perspectives sur la strategie technologique, la gouvernance et l'integration de l'IA."
>
  <section class="bg-[#F8FAFC] min-h-[calc(100vh-80px)] py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight text-[#23545B]">Perspectives</h1>
      <p class="mt-3 max-w-3xl text-slate-600">Explorations executives sur la technologie, les risques et l'impact d'affaires.</p>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {entries.map((entry) => (
          <article class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500">{entry.data.pubDate.toLocaleDateString('fr-CA')}</p>
            <h2 class="mt-2 text-2xl font-semibold text-[#23545B] transition-colors hover:text-[#FF6F61]">
              <a href={toInsightUrl(entry.id)} class="no-underline">{entry.data.title}</a>
            </h2>
            <p class="mt-2 text-slate-600">{entry.data.excerpt}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
