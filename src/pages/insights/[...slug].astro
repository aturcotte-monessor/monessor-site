---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('insights', ({ id, data }) => id.startsWith('fr/') && data.lang === 'fr');

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^fr\//, '').replace(/\.md$/, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const metaParts = [entry.data.readTime, entry.data.author].filter(Boolean);

let switchHref = `/en/insights/${entry.id.replace(/^fr\//, '').replace(/\.md$/, '')}/`;

if (entry.data.translationKey) {
  const counterpart = await getCollection(
    'insights',
    ({ id, data }) => id.startsWith('en/') && data.lang === 'en' && data.translationKey === entry.data.translationKey
  );

  if (counterpart.length > 0) {
    switchHref = `/en/insights/${counterpart[0].id.replace(/^en\//, '').replace(/\.md$/, '')}/`;
  }
}

// --- AJOUTS SEO & DONNÉES STRUCTURÉES ---
const siteUrl = 'https://www.monessor.com';
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentUrl
  },
  "headline": entry.data.title,
  "description": entry.data.excerpt,
  "inLanguage": "fr-CA",
  "datePublished": entry.data.pubDate.toISOString(),
  "dateModified": (entry.data.updatedDate || entry.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": entry.data.author || "Alex Turcotte",
    "jobTitle": entry.data.authorTitle || "Directeur principal & CTO à temps partagé",
    "sameAs": "https://www.linkedin.com/in/alexturcotte/"
  },
  "image": {
    "@type": "ImageObject",
    "url": `${siteUrl}/assets/og-insight-default.png`,
    "width": "1200",
    "height": "627"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Monessor",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/assets/logo.png`
    }
  },
  ...(entry.data.tags && { "keywords": entry.data.tags.join(", ") })
};
---

<Layout locale="fr" switchHref={switchHref} title={`${entry.data.title} - Par ${entry.data.author || 'Alex Turcotte'}`} description={entry.data.excerpt} image="/assets/og-insight-default.png">
  <Fragment slot="head">
    <!-- Balises Open Graph & Twitter pour le partage social -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:description" content={entry.data.excerpt} />
    <meta property="og:url" content={currentUrl} />
    <meta property="article:published_time" content={entry.data.pubDate.toISOString()} />
    <meta property="article:author" content={entry.data.author || "Alex Turcotte"} />
    <meta name="twitter:card" content="summary_large_image" />       
    <meta name="twitter:image" content={`${siteUrl}/assets/og-insight-default.png`} />
    <meta name="twitter:title" content={entry.data.title} />
    <meta name="twitter:description" content={entry.data.excerpt} />
        
    <!-- Images pour Open Graph (LinkedIn) & Twitter -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="Monessor - Conseil en stratégie technologique & direction TI" />
    
    <!-- Schema.org BlogPosting Structured Data for Googlebot -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="bg-[#F8FAFC] min-h-[calc(100vh-80px)] py-16">
    <article class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-xs uppercase tracking-[0.14em] text-slate-500">
        {entry.data.pubDate.toLocaleDateString('fr-CA')}
        {metaParts.length > 0 ? ` • ${metaParts.join(' • ')}` : ''}
      </p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-[#23545B]">{entry.data.title}</h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-700">{entry.data.excerpt}</p>

      <div class="mt-10 max-w-none [&_p]:text-slate-800 [&>p]:mb-6 [&>p]:leading-relaxed [&_h2]:text-[#23545B] [&_h2]:font-semibold [&>h2]:mt-10 [&>h2]:mb-4 [&>h2]:text-xl [&>h2]:font-bold [&>h2]:text-[#23545B] [&_h3]:text-[#23545B] [&_h3]:font-semibold [&>h3]:mt-8 [&>h3]:mb-3 [&_a]:text-[#23545B] hover:[&_a]:text-[#FF6F61] [&_ul]:text-slate-700 [&>ul]:my-6 [&>ul]:space-y-2 [&>ul]:list-disc [&>ul]:pl-6 [&_ol]:text-slate-700 [&_blockquote]:text-slate-700 [&_li]:text-slate-700">
        <Content />
      </div>

      <div class="mt-12 rounded-2xl bg-[#23545B] p-8 text-white">
        <h2 class="text-2xl font-semibold">Besoin d'un regard exécutif sur ces enjeux?</h2>
        <p class="mt-3 text-slate-200">Échangeons sur votre contexte et vos priorités technologiques.</p>
        <a href="https://calendar.app.google/jrWp3LMihMCr5qew7" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full bg-[#FF6F61] px-5 py-3 font-semibold text-white no-underline hover:brightness-95">
          Planifier une rencontre
        </a>
      </div>
    </article>
  </section>
</Layout>