---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import InsightCard from '../components/InsightCard.astro';
import { ui } from '../i18n/ui';

const locale = 'fr' as const;
const entries = (await getCollection('insights', ({ id, data }) => id.startsWith('fr/') && data.lang === locale)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
).slice(0, 3);
const insightsHref = '/insights/';
const sectionTitle = ui[locale].perspectivesTitle;
const ctaLabel = ui[locale].exploreAllInsights;
---

<Layout
  locale={locale}
  title="Monessor — CTO à temps partagé, stratégie TI & gouvernance réglementaire"
  description="Cabinet-conseil en stratégie technologique mené par Alex Turcotte. Spécialisé en intégration de l'IA, CTO à temps partagé et gouvernance des TI pour secteurs régulés."
>
  <link slot="head" rel="stylesheet" href="/css/styles.css" />

  <!-- HERO -->
  <section class="section hero">
    <div class="container hero-grid max-w-7xl mx-auto px-6 lg:px-8">
      <div>
        <p class="kicker">Pratique Exécutive • CTO à temps partagé & Conseil en Gouvernance TI</p>
        <h1>
            <span class="block text-base font-semibold uppercase tracking-wider text-accent mb-2">Conseil en stratégie technologique & direction TI</span>
            Clarté. Gouvernance. Exécution.
        </h1>
        <p class="lead">
            Monessor appuie les organisations et équipes de direction face à des enjeux technologiques complexes:&nbsp 
            <strong>CTO à temps partagé (Fractional CTO)</strong>, intégration et gouvernance de l'<strong>intelligence artificielle</strong> et modernisation de plateformes critiques.
        </p>
        <p class="hero-synthesis hero-synthesis--desktop" aria-hidden="false">
          Monessor intervient lorsque la technologie et le produit deviennent des enjeux stratégiques
          et que les arbitrages ne sont plus clairs au niveau exécutif. L'objectif consiste alors à rétablir
          une trajectoire soutenable, sans compromettre la stabilité, la conformité ou l'impact.
        </p>

        <p class="hero-synthesis hero-synthesis--mobile" aria-hidden="true">
          Monessor intervient lorsque la technologie et le produit deviennent stratégiques
          et que des arbitrages clairs sont nécessaires au niveau exécutif.
        </p>

        <p class="hero-detail">
          En travaillant aux côtés des équipes de direction, Monessor clarifie les priorités et les
          arbitrages entre produit, technologie et risques, tout en stabilisant les plateformes critiques
          et en guidant les efforts de modernisation pour traduire les décisions technologiques en résultats
          d'affaires durables.
        </p>
        <div class="hero-cta">
          <a class="btn" href="#contact">Entrer en contact</a>
          <a class="btn btn--ghost" href="#situations">Voir les situations</a>
        </div>

        <div class="microproof">
          <div class="pill">Montréal</div>
          <div class="pill">Québec & Canada</div>
          <div class="pill">Environnements complexes</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SITUATIONS -->
  <section class="section" id="situations">
    <div class="container max-w-7xl mx-auto px-6 lg:px-8">
      <h2>Champs d'intervention</h2>
      <p class="sublead">
        Lorsque la technologie devient un enjeu stratégique, opérationnel ou de gouvernance.
      </p>

      <div class="cards">
        <article class="card">
          <h3>Plateformes en tension</h3>
          <p>Systèmes critiques, dette technique et livraison imprévisible.</p>
        </article>
        <article class="card">
          <h3>Intelligence artificielle & automatisation</h3>
          <p>Évaluation d'opportunités AI/ML, business cases et intégration stratégique en environnements régulés.</p>
        </article>
        <article class="card">
          <h3>Modernisation</h3>
          <p>Trajectoire legacy → cible, arbitrages coût / risque / valeur.</p>
        </article>
        <article class="card">
          <h3>Gouvernance & décisions</h3>
          <p>Alignement direction, IT et risques.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- WHEN MOST USEFUL -->
  <section class="section" id="useful">
    <div class="container max-w-7xl mx-auto px-6 lg:px-8">
      <h2>Quand Monessor apporte le plus de valeur</h2>
      <div class="cards">
        <article class="card">
          <p>
            Lorsque la technologie est devenue critique pour l'organisation, mais que les priorités,
            les risques et les responsabilités ne sont plus clairement alignés.
          </p>
        </article>
        <article class="card">
          <p>
            Lorsqu'une plateforme centrale doit être modernisée sans mettre en péril la stabilité,
            la conformité réglementaire ou la confiance des parties prenantes.
          </p>
        </article>
        <article class="card">
          <p>
            Lorsqu'une organisation souhaite évaluer l'intelligence artificielle et l'automatisation
            en s'assurant que les investissements soient guidés par des cas d'affaires solides plutôt
            que par l'effet de mode.
          </p>
        </article>
        <article class="card">
          <p>
            Quand les équipes livrent beaucoup d'efforts, mais que l'impact réel reste difficile à
            mesurer ou à expliquer au niveau exécutif.
          </p>
        </article>
        <article class="card">
          <p>
            Lorsqu'il existe une tension persistante entre les impératifs produit, technologiques
            et opérationnels, sans cadre clair pour arbitrer.
          </p>
        </article>
        <article class="card">
          <p>
            Quand une organisation a besoin d'un leadership technologique et produit senior,
            sans nécessairement recruter immédiatement un CTO ou CPTO à temps plein.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--alt" id="services">
    <div class="container max-w-7xl mx-auto px-6 lg:px-8">
      <h2>Services</h2>

      <div class="trust-badges">
        <div class="badge">
          <div class="badge-value">20+</div>
          <div class="badge-label">Ans de leadership technologique senior</div>
        </div>
        <div class="badge">
          <div class="badge-value">Pragmatique</div>
          <div class="badge-label">Approche exécutive orientée résultats</div>
        </div>
        <div class="badge">
          <div class="badge-value">100%</div>
          <div class="badge-label">Livraison par consortium d'experts chevronnés</div>
        </div>
      </div>

      <div class="accordion-container">
        <div class="accordion-item">
          <button class="accordion-trigger" aria-expanded="false" aria-controls="service-1-content">
            <span>CTO à temps partagé</span>
            <svg class="accordion-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-content" id="service-1-content">
            <p class="accordion-text">
              Un leadership technologique senior intégré à votre équipe de direction pour aligner la feuille de route produit avec vos objectifs d'affaires. Nous intervenons dans la définition des plans 30-60-90 jours, la gestion de crise et la stabilisation des équipes techniques sans les coûts d'un exécutif permanent.
            </p>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-trigger" aria-expanded="false" aria-controls="service-2-content">
            <span>Stratégie &amp; gouvernance</span>
            <svg class="accordion-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-content" id="service-2-content">
            <p class="accordion-text">
              Traduction de la vision d'affaires en architectures robustes et sécurisées. Nous concevons les cadres décisionnels nécessaires pour naviguer les environnements hautement régulés (BSIF / OSFI), optimiser l'organisation de vos équipes et structurer vos initiatives IA et automatisation.
            </p>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-trigger" aria-expanded="false" aria-controls="service-3-content">
            <span>Modernisation de plateformes</span>
            <svg class="accordion-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-content" id="service-3-content">
            <p class="accordion-text">
              Arbitrage pragmatique <em>Build vs Buy</em>, réduction de la dette technique héritée (<em>legacy</em>) et évaluation de la viabilité des plateformes. Nous sécurisons vos trajectoires de migration pour minimiser les risques opérationnels et maximiser le rendement de vos investissements technologiques.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- APPROCHE -->
  <section class="section" id="approche">
    <div class="container max-w-7xl mx-auto px-6 lg:px-8">
      <h2>Approche</h2>

      <div class="steps">
        <div class="step">
          <p class="step-num">01</p>
          <h3>Clarifier</h3>
          <p>Enjeux, contraintes, risques et décisions structurantes.</p>
        </div>
        <div class="step">
          <p class="step-num">02</p>
          <h3>Structurer</h3>
          <p>Options, trajectoire, gouvernance et priorisation.</p>
        </div>
        <div class="step">
          <p class="step-num">03</p>
          <h3>Exécuter</h3>
          <p>Accompagnement ou direction de l’exécution.</p>
        </div>
      </div>

      <div class="note">
        <p><strong>Ce que Monessor n’est pas :</strong> une agence de développement ou une usine de mots à la mode.</p>
      </div>
    </div>
  </section>

  <!-- PERSPECTIVES -->
  <section class="w-full bg-slate-50 py-16 text-slate-900" id="perspectives">
    <div class="container max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-slate-900">{sectionTitle}</h2>
      <div class="cards cards--insights insights-grid mt-6">
        {entries.map((entry) => (
          <InsightCard
            entry={entry}
            href={`/insights/${entry.id.replace(/^fr\//, '').replace(/\.md$/, '')}/`}
            locale={locale}
            variant="light"
          />
        ))}
      </div>
      <div class="mt-8">
        <a class="inline-flex items-center px-6 py-3 bg-[#88d8b0] text-slate-900 font-semibold rounded-full hover:opacity-90 transition-all" href={insightsHref}>{ctaLabel}</a>
      </div>
    </div>
  </section>

  <!-- DIRECTION DE LA PRATIQUE -->
  <section class="section section--alt" id="apropos">
    <div class="container max-w-7xl mx-auto px-6 lg:px-8">
      <h2>Direction de la pratique</h2>
      <h3 style="margin-top: 0; font-size: 20px; color: var(--muted); margin-bottom: 24px;">Alex Turcotte, Directeur Principal</h3>

      <div class="about">
        <div>
          <p class="lead">
            Alex Turcotte pilote la pratique Monessor en tant que CTO / CPTO auprès d'équipes de direction confrontées
            à des enjeux technologiques, produit et organisationnels complexes.
            Il mobilise un écosystème agile et un consortium d'experts pour structurer et livrer les mandats avec rigueur.
          </p>
          <p>
            Fort de plus de vingt ans d'expérience à la jonction de la technologie, du produit et de la gouvernance,
            Alex intervient principalement dans des organisations où les plateformes sont critiques, les contraintes réglementaires fortes
            et les décisions technologiques étroitement liées aux enjeux d'affaires. Son rôle consiste à remettre de la clarté là où la complexité s'est accumulée&nbsp;:
            priorités floues, dette technique mal comprise, tensions entre livraison à court terme et durabilité à long terme,
            ou encore évaluation d'opportunités d'intelligence artificielle et d'automatisation dans des contextes où la conformité et la gouvernance sont non négociables.
          </p>

          <p>
            Entre 2018 et 2021, Alex a occupé des rôles de leadership produit, en tant que Product Lead et Squad Lead, avec une
            responsabilité complète sur la définition, la livraison et l'adoption de produits numériques utilisés par des acteurs clés des
            marchés financiers. Cette expérience façonne son approche&nbsp;: la technologie n'a de valeur que lorsqu'elle sert des
            usages clairs, compris et assumés.
          </p>
          <p>
            Il est reconnu pour un style de leadership calme, structuré et pragmatique, particulièrement utile dans des contextes de transition,
            de modernisation ou de croissance contrainte. Monessor s'appuie sur un réseau d'experts chevronnés et de partenaires spécialisés,
            permettant de mobiliser les ressources appropriées selon la nature et l'ampleur des enjeux. Cette approche en consortium garantit
            une livraison rigoureuse tout en maintenant l'agilité et la réactivité nécessaires aux défis de transformation.
          </p>
        </div>
        <div class="about-box">
          <div class="hero-card">
            <div class="portrait">
                <img 
                    src="/assets/alex.jpg" 
                    alt="Alex Turcotte, CTO à temps partagé et Fondateur de Monessor" 
                    width="400" 
                    height="400" 
                    loading="eager"
                />
            </div>
            <div class="hero-card-body">
              <p class="name">Alex Turcotte</p>
              <p class="title">Fondateur - Monessor</p>
              <p class="small">
                CTO à temps partagé et conseiller exécutif en stratégie technologique,
                modernisation de plateformes et gouvernance.
              </p>
              <br />
              <div class="hero-card-links">
                <a class="libutton" href="https://www.linkedin.com/comm/mynetwork/discovery-see-all?usecase=PEOPLE_FOLLOWS&amp;followMember=turcottealex" target="_blank">Suivre sur LinkedIn</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section" id="contact">
    <div class="container max-w-7xl mx-auto px-6 lg:px-8">
      <h2>Contact</h2>
      <p class="sublead">
        Dites-nous ce que vous essayez d’accomplir et où ça bloque.
        Une réponse vous sera transmise rapidement.
      </p>

      <div class="contact-box">
        <div class="contact-actions">
          <a id="email-button" class="btn font-semibold" href="#" aria-label="Écrire un courriel">
            Écrire un courriel
          </a>
          <a class="btn btn--outline" href="https://calendar.app.google/jrWp3LMihMCr5qew7" target="_blank" rel="noopener noreferrer" aria-label="Planifier une rencontre">
            Planifier une rencontre
          </a>
        </div>
        <p class="small contact-meta contact-meta--phone">
          <span class="contact-label">Téléphone :</span>
          <span class="contact-value"><span class="phone-secure" aria-label="Numéro de téléphone">Appeler</span></span>
        </p>
        <p class="small contact-meta">
          <span class="contact-label">Ou directement :</span>
          <a id="email-link-2" class="contact-value" href="#" aria-label="Adresse courriel">
            <span data-user="info" data-domain="monessor" data-tld="com">Contact</span>
          </a>
        </p>
      </div>

      <footer class="footer">
        <p class="small footer-line">© <span id="year"></span> Services-conseils Monessor inc. <span class="footer-separator" aria-hidden="true"> | </span> <span class="contact-label">Téléphone :</span> <span class="contact-value"><span class="phone-secure" aria-label="Numéro de téléphone">Appeler</span></span></p>
      </footer>
    </div>
  </section>

  <script slot="scripts" src="/scripts/main.js"></script>
</Layout>
