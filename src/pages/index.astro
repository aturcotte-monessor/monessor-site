---
// Racine du site. En production, Vercel redirige « / » avant d'atteindre cette page (voir vercel.json) :
// vers /en/ si la première langue du navigateur est l'anglais, sinon vers /fr/.
// Cette page ne sert que de repli (prévisualisation locale, robots sans redirection) : non indexée,
// elle oriente selon la langue du navigateur et offre les deux liens.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Monessor</title>
    <link rel="alternate" hreflang="fr" href="https://www.monessor.com/fr/" />
    <link rel="alternate" hreflang="en" href="https://www.monessor.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://www.monessor.com/" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <script is:inline>
      (function () {
        var lang = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
        location.replace(lang.indexOf('en') === 0 ? '/en/' : '/fr/');
      })();
    </script>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #102A2E; color: #F8FAFC; font-family: system-ui, sans-serif; }
      nav { display: flex; gap: 24px; }
      a { color: #F8FAFC; font-weight: 600; }
    </style>
  </head>
  <body>
    <nav aria-label="Langue / Language">
      <a href="/fr/" lang="fr">Français</a>
      <a href="/en/" lang="en">English</a>
    </nav>
  </body>
</html>
