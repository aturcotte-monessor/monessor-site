---
import Layout from '../../layouts/Layout.astro';

const links = [
  { href: '/en/services/sme/', label: 'SMEs', text: 'Fractional CTO, IT Maturity Diagnostic' },
  { href: '/en/services/regulated-financial-services/', label: 'Regulated financial services', text: 'IT governance and OSFI compliance' },
  { href: '/en/insights/', label: 'Insights', text: 'Analysis on technology, risk and governance' }
];
---

<Layout
  locale="en"
  title="Page not found | Monessor"
  description="This page does not exist or has been moved."
  meeting={false}
  noindex
  switchHref="/fr/"
>
  <section class="bg-light py-20 text-ink">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal">Error 404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-teal">Page not found</h1>
      <p class="mt-4 text-lg">This page does not exist or has been moved. Here are the main sections of the site.</p>
      <ul class="mt-10 grid gap-4">
        {links.map((link) => (
          <li>
            <a href={link.href} class="block rounded-2xl border border-slate-200 bg-white p-6 hover:border-teal/40 hover:no-underline">
              <span class="block text-lg font-semibold text-teal">{link.label} →</span>
              <span class="mt-1 block">{link.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-10">
        <a href="/en/" class="font-semibold text-teal underline underline-offset-4">Back to home</a>
        <span aria-hidden="true"> · </span>
        <a href="/fr/" lang="fr" class="text-teal underline underline-offset-4">Site en français</a>
      </p>
    </div>
  </section>
</Layout>
