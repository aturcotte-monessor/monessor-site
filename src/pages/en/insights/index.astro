---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import InsightCard from '../../../components/InsightCard.astro';

const entries = (await getCollection('insights', ({ id, data }) => id.startsWith('en/') && data.lang === 'en')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const toInsightUrl = (id: string) => `/en/insights/${id.replace(/^en\//, '').replace(/\.md$/, '')}/`;
---

<Layout
  locale="en"
  title="Insights - Monessor"
  description="Executive perspectives on technology strategy, governance, and AI integration."
>
  <section class="bg-[#F8FAFC] min-h-[calc(100vh-80px)] py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight text-[#23545B]">Insights</h1>
      <p class="mt-3 max-w-3xl text-slate-600">Executive analysis on technology, risk, and durable business outcomes.</p>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {entries.map((entry) => (
          <InsightCard entry={entry} href={toInsightUrl(entry.id)} locale="en" elevateOnHover={false} />
        ))}
      </div>
    </div>
  </section>
</Layout>
