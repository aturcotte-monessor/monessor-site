---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import InsightCard from '../../components/InsightCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import Icon from '../../components/Icon.astro';
import ChevronLines from '../../components/ChevronLines.astro';
import { MEETING_URL, fathomEvent } from '../../utils/tracking';
import { articleSegments } from '../../utils/articleSegments';
import { ui } from '../../i18n/ui';

const locale = 'en' as const;
const pathname = Astro.url.pathname;
const allInsights = await getCollection('insights');
const entries = allInsights
  .filter(({ id, data }) => id.startsWith('en/') && data.lang === locale)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const serviceSme = '/en/services/sme/';
const serviceFs = '/en/services/regulated-finance/';

const symptoms = [
  {
    icon: 'wallet' as const,
    title: 'IT budgets that grow without visible returns',
    text: 'Software, cloud, vendors: spending rises every year, and no one can say precisely what it delivers.'
  },
  {
    icon: 'server-cog' as const,
    title: 'Critical systems in too few hands',
    text: 'Your ERP, key applications or data depend on a handful of people or a single vendor.'
  },
  {
    icon: 'brain-circuit' as const,
    title: 'AI decisions made under pressure',
    text: 'Pitches keep coming, with no framework to separate profitable projects from passing trends.'
  }
];

const sequence = [
  { step: '01', title: 'IT Maturity Diagnostic', text: 'Where you stand, the risks and the priorities, in 2 to 3 weeks.' },
  { step: '02', title: 'Targeted deliverables', text: 'Two or three focused engagements that follow from the diagnostic: ERP selection, a vendor tender, a modernization plan.' },
  { step: '03', title: 'Fractional IT leadership', text: 'A regular seat on your leadership team, about one day a week, to steer execution.' }
];

const situations = [
  {
    icon: 'layers' as const,
    title: 'A critical platform to modernize',
    text: 'Your core system has to evolve without putting operations, compliance or customer trust at risk.'
  },
  {
    icon: 'scale' as const,
    title: 'Investments to prioritize',
    text: 'Several projects compete for the same budget and leadership wants an independent view on cost, risk and value.'
  },
  {
    icon: 'search-check' as const,
    title: 'AI to assess with method',
    text: 'You want to know where artificial intelligence and automation will create real value, backed by a business case.'
  },
  {
    icon: 'compass' as const,
    title: 'Technology leadership without an immediate hire',
    text: 'You need an experienced CTO at the leadership table without recruiting a full-time executive right away.'
  }
];

const steps = [
  { icon: 'search' as const, step: '01', title: 'Clarify', text: 'The issues, constraints, risks and decisions to be made.' },
  { icon: 'route' as const, step: '02', title: 'Structure', text: 'The options, trajectory, governance and priorities.' },
  { icon: 'flag' as const, step: '03', title: 'Execute', text: 'Support for delivery, or leading it.' }
];

const container = 'mx-auto max-w-7xl px-6 lg:px-8';
---

<Layout
  locale={locale}
  meetingId="contact"
  title="Strategic IT Management Advisory for SMEs | Monessor"
  description="Monessor helps SME leaders govern technology with the rigour of regulated financial services, starting with an IT Maturity Diagnostic."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-teal-deep">
    <ChevronLines class="h-[112px] w-[168px] lg:h-[200px] lg:w-[300px] xl:h-[300px] xl:w-[450px]" />
    <div class={`relative ${container} pt-20 pb-28 lg:py-28`}>
      <p class="home-kicker text-coral">Strategic IT management advisory</p>
      <h1 class="home-h1">Govern your technology with the same rigour as your finances.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-light/85">
        Monessor works with SME leaders, bringing governance practices
        proven in regulated financial services: clear priorities, known risks, and technology investments you can
        defend in front of your board.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ContactCta
          href={MEETING_URL}
          label="Book a meeting"
          className="btn"
          fathomEventName={fathomEvent('ScheduleMeeting', 'Hero', locale, pathname)}
        />
        <a class="btn btn--outline" href={`${serviceSme}#diagnostic`}>See the Diagnostic</a>
      </div>
    </div>
  </section>

  <!-- SME -->
  <section class="bg-light py-20 text-ink" id="sme">
    <div class={container}>
      <p class="home-kicker text-teal">For SMEs</p>
      <h2 class="home-h2">When technology holds growth back</h2>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {symptoms.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6">
            <Icon name={item.icon} size={28} class="mb-4 text-teal" />
            <h3 class="home-h3">{item.title}</h3>
            <p class="mt-3 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>

      <div class="mt-12 grid gap-10 rounded-2xl border border-slate-200 bg-white p-8 lg:grid-cols-[1fr_1.2fr] lg:p-10">
        <div>
          <h3 class="home-h3 text-2xl">The starting point: the IT Maturity Diagnostic</h3>
          <p class="mt-4 leading-relaxed">
            In 2 to 3 weeks, an independent picture of your systems, risks and technology spending, with a costed
            18-month roadmap ready to present to your board.
          </p>
          <p class="mt-4 font-semibold text-teal">From $12,500, fixed-scope engagement.</p>
          <a class="btn btn--outline-teal mt-6" href={serviceSme}>Explore the SME offer</a>
        </div>
        <ol class="grid gap-6">
          {sequence.map((item) => (
            <li class="flex gap-4">
              <span class="mt-0.5 shrink-0 font-bold tracking-[0.12em] text-teal">{item.step}</span>
              <div>
                <h4 class="font-semibold text-teal">{item.title}</h4>
                <p class="mt-1 leading-relaxed">{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- FINANCIAL SERVICES -->
  <section class="bg-light pb-20 text-ink" id="financial-services">
    <div class={container}>
      <div class="flex flex-col gap-6 border-t border-slate-200 pt-12 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <h2 class="home-h3 text-2xl">A financial institution or a FinTech?</h2>
          <p class="mt-3 leading-relaxed">
            Monessor also helps financial institutions and FinTechs align their IT governance with OSFI guidelines:
            third-party risk management (B-10), technology and cyber risk (B-13), and model risk management (E-23).
          </p>
        </div>
        <a class="shrink-0 font-semibold text-teal underline underline-offset-4" href={serviceFs}>Explore the IT Governance Review →</a>
      </div>
    </div>
  </section>

  <!-- WHEN TO CALL ON MONESSOR -->
  <section class="bg-white py-20 text-ink" id="situations">
    <div class={container}>
      <h2 class="home-h2">When to call on Monessor</h2>
      <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {situations.map((item) => (
          <div class="flex gap-4">
            <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-light text-teal">
              <Icon name={item.icon} size={22} />
            </span>
            <div>
              <h3 class="home-h3">{item.title}</h3>
              <p class="mt-2 leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="bg-light py-20 text-ink" id="approach">
    <div class={container}>
      <h2 class="home-h2">Approach</h2>
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        {steps.map((item) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <div class="flex items-center justify-between text-teal">
              <Icon name={item.icon} size={28} />
              <span class="font-bold tracking-[0.12em]">{item.step}</span>
            </div>
            <h3 class="home-h3 mt-2">{item.title}</h3>
            <p class="mt-2 leading-relaxed">{item.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-8 rounded-2xl bg-teal p-6 text-light md:p-8">
        <p class="text-lg font-semibold">No commissions. No software resale.</p>
        <p class="mt-2 text-light/90">
          Monessor is neither a development agency nor a software reseller. It is paid by its clients only, so its
          recommendations serve no interest but yours.
        </p>
      </div>
      <a class="mt-6 inline-block font-semibold text-teal underline underline-offset-4" href="/en/approach/">Explore our approach →</a>
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="relative overflow-hidden bg-teal-deep py-16 lg:py-20">
    <ChevronLines class="h-[56px] w-[84px] xl:h-[160px] xl:w-[240px]" />
    <div class={container}>
      <p class="max-w-4xl text-3xl font-semibold leading-tight text-light md:text-4xl">
        Rigour doesn’t slow growth down. It makes it <span class="text-coral">last</span>.
      </p>
    </div>
  </section>

  <!-- INSIGHTS -->
  <section class="bg-light py-20 text-ink" id="perspectives">
    <div class={container}>
      <h2 class="home-h2">{ui[locale].perspectivesTitle}</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {entries.map((entry) => (
          <InsightCard
            entry={entry}
            href={`/en/insights/${entry.id.replace(/^en\//, '')}/`}
            locale={locale}
            segments={articleSegments(entry, allInsights)}
            headingLevel={3}
          />
        ))}
      </div>
      <a class="btn btn--outline-teal mt-8" href="/en/insights/">{ui[locale].exploreAllInsights}</a>
    </div>
  </section>

  <!-- PROFILE -->
  <section class="bg-white py-20 text-ink" id="about">
    <div class={`${container} grid items-center gap-10 md:grid-cols-[220px_1fr] lg:gap-14`}>
      <img
        src="/assets/alex.jpg"
        alt="Portrait of Alex Turcotte"
        width="220"
        height="220"
        loading="lazy"
        decoding="async"
        class="h-[220px] w-[220px] rounded-2xl object-cover"
      />
      <div class="max-w-3xl">
        <p class="home-kicker text-teal">About</p>
        <h2 class="home-h2">Alex Turcotte, Managing Partner</h2>
        <p class="mt-4 leading-relaxed">
          For more than twenty years, Alex Turcotte has worked where technology, product and governance meet, including
          more than fifteen years at a leading Canadian capital markets organization, where platforms are critical and
          regulation is demanding. He works alongside leadership teams
          to clarify priorities, keep risk under control and turn technology decisions into business results.
        </p>
        <p class="mt-4 leading-relaxed">
          Every engagement is led personally by Alex Turcotte, Managing Partner. When an engagement calls for highly
          specialized expertise, Monessor brings in a specialist from its network.
        </p>
        <a
          class="btn btn--outline-teal mt-6"
          href="https://www.linkedin.com/in/turcottealex"
          target="_blank"
          rel="noopener noreferrer"
          data-fathom-event={fathomEvent('LinkedIn', 'Profile', locale, pathname)}
        >LinkedIn profile</a>
        <a class="ml-4 mt-6 inline-block font-semibold text-teal underline underline-offset-4" href="/en/about/">Read the full profile →</a>
      </div>
    </div>
  </section>
</Layout>
