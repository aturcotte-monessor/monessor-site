---
import ServicePage from '../../../components/ServicePage.astro';

const url = 'https://www.monessor.com/en/services/sme/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Strategic IT management advisory for SMEs',
  serviceType: 'Strategic IT management advisory',
  url,
  provider: { '@id': 'https://www.monessor.com/#organisation' },
  areaServed: { '@type': 'Country', name: 'Canada' },
  availableLanguage: ['en', 'fr'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Offers for SMEs',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'IT Spot Check' },
        price: 1500,
        priceCurrency: 'CAD'
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'IT Health Check' },
        price: 4500,
        priceCurrency: 'CAD'
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Full IT Audit' },
        price: 23750,
        priceCurrency: 'CAD'
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Custom Software Solutions' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Vendor selection and arbitration' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Fractional IT leadership' },
        priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 8000, priceCurrency: 'CAD', unitText: 'month' }
      }
    ]
  }
};
---

<ServicePage
  locale="en"
  segment="pme"
  title="IT Health Check, IT Audit and IT Leadership for SMEs | Monessor"
  description="For SMEs: an IT Health Check for $4,500, a full digital audit of your IT for $23,750, custom software solutions built with AI from $15,000, and fractional IT leadership."
  jsonLd={jsonLd}
  hero={{
    kicker: 'Strategic IT management advisory · SMEs',
    title: 'Take back control of your technology investments.',
    lead: 'Monessor helps you modernize aging systems, choose the right projects, govern artificial intelligence and put it to work, and deliver custom tools, with pragmatism and rigour. Our clients are mostly in manufacturing, distribution and services.',
    secondary: { label: 'Where to start', href: '#diagnostic' }
  }}
  issues={{
    id: 'symptomes',
    title: 'Where technology stops being a lever and becomes a risk',
    audience: 'Most often, companies with 20 to 250 employees.',
    items: [
      {
        icon: 'wallet',
        title: 'Projects that drift and costs out of control',
        text: 'IT budgets and infrastructure bills that grow every year with no clear view of the return, and important projects that keep slipping.'
      },
      {
        icon: 'server-cog',
        title: 'Technical debt and critical dependencies',
        text: 'Complex, fragile core systems (ERP, CRM, in-house applications) kept running by a few key people or a single vendor, with no fallback.'
      },
      {
        icon: 'brain-circuit',
        title: 'AI under pressure, without a business case',
        text: 'Pressure to adopt artificial intelligence with no measurable return, at the risk of spending heavily without creating operational value.'
      },
      {
        icon: 'scale',
        title: 'A strained dialogue between finance and IT',
        text: 'A finance team focused on margins and the balance sheet, facing technical teams absorbed by day-to-day firefighting.'
      },
      {
        icon: 'workflow',
        title: 'Production and inventory',
        text: 'Inventory and work orders live in Excel or on paper: production figures arrive too late to act on.'
      },
      {
        icon: 'lock',
        title: 'Cybersecurity never put to the test',
        text: 'Ransomware would stop production: backups and access have never been tested.'
      }
    ]
  }}
  offer={{
    id: 'diagnostic',
    kicker: 'Starting point',
    title: 'Two ways to start',
    lead: 'A first look to know where you stand, or a full audit to know what to do, in what order and for what return. Either way, we start from your actual systems and your actual contracts, not from a self-assessment.',
    cards: [
      {
        title: 'IT Health Check',
        tagline: 'An expert’s view of all your IT, and your priorities for the next 12 months.',
        meta: '2 to 3 weeks · half a day of your time',
        text: 'Your five main risks, three quick wins, AI opportunities and a budget estimate, presented to your leadership team.',
        price: '$4,500, fixed price'
      },
      {
        title: 'Full IT Audit',
        tagline: 'Every system, contract and control verified, with evidence, and a costed roadmap.',
        meta: '4 to 6 weeks',
        text: 'Every business function reviewed, key controls verified, AI use cases costed and an 18-month plan.',
        price: '$23,750, fixed price',
        scope: 'For one site, up to 10 systems, 5 interviews and 2 processes in depth. Different situation? We adjust the scope before we start, never along the way.'
      }
    ],
    notes: [
      'Moving on within 60 days? What you paid is deducted from the next step.',
      'A specific question? The IT Spot Check: a two-hour workshop and a written opinion, $1,500.'
    ],
    itemsTitle: 'What the Full IT Audit covers',
    items: [
      {
        icon: 'layers',
        title: 'Your functions, your processes and the real state of your systems',
        text: 'Every business function, from sales to payroll, and an independent review of your core systems: their stability, the risk of outages and what they really cost you, licences, maintenance and support included.'
      },
      {
        icon: 'lock',
        title: 'Your cybersecurity and your ability to recover',
        text: 'The controls that can stop your business are verified, not just declared: restorable backups, multi-factor authentication, access for departed employees and vendors.'
      },
      {
        icon: 'handshake',
        title: 'Your contracts, your vendors and your costs',
        text: 'An independent look at your contracts, licences and cloud costs, with the dependencies to reduce and the renegotiation opportunities.'
      },
      {
        icon: 'map',
        title: 'AI and a costed 18-month plan',
        text: 'The most profitable uses of AI and automation, each with its estimated return, then a prioritized plan: where to invest, in what order, and how to support your teams through the change.'
      }
    ]
  }}
  solutions={{
    id: 'solutions',
    kicker: 'A first concrete gain',
    title: 'Custom Software Solutions',
    subtitle: 'Built with AI, delivered with every discipline a real software product needs.',
    promise: 'A custom tool that removes one specific friction point, delivered in weeks with the rigour of a software product.',
    price: 'From $15,000, fixed price, in 2 to 6 weeks.',
    ai: {
      title: 'AI, at two levels',
      items: [
        {
          icon: 'brain-circuit',
          title: 'In the tool',
          text: 'The tool can read invoices, classify documents, normalize data or answer questions about your company’s data.'
        },
        {
          icon: 'rocket',
          title: 'To build it',
          text: 'AI speeds up development, which makes a custom tool affordable for an SME. Engineering rigour keeps the result reliable and easy to maintain.'
        }
      ]
    },
    examples: {
      title: 'Examples',
      items: [
        { icon: 'calculator', title: 'Automate a repetitive accounting task', text: 'For example, entering and reconciling supplier invoices.' },
        { icon: 'database', title: 'Prepare your data for an ERP or CRM', text: 'Clean, normalize and prepare data before it is imported.' },
        { icon: 'wrench', title: 'Build a small internal tool', text: 'To save a team time, or to set your company apart with its clients.' },
        { icon: 'puzzle', title: 'Add an extension to your ERP or CRM', text: 'For example, a quote calculation or a missing report.' },
        { icon: 'list-checks', title: 'Manufacturing', text: 'Track production, prepare quotes or digitize work orders.' }
      ]
    },
    included: {
      title: 'The rigour, with no blind spots',
      items: [
        { icon: 'target', title: 'A measured gain before any code', text: 'A short 2-to-3-day scoping step, always included, pins down the friction point and measures the expected gain before any development.' },
        { icon: 'lock', title: 'Security and personal information by design', text: 'Access, data and compliance with Quebec’s Law 25 are handled from the start, not as an afterthought.' },
        { icon: 'file-text', title: 'Tests, documentation and handover', text: 'The code is tested and documented, then handed over to your team, with the option to train internal champions.' },
        { icon: 'key-round', title: 'Your code, your data', text: 'The code and the data belong to you and are hosted in your environment.' }
      ]
    },
    disciplines: {
      title: 'Every discipline of a real software product',
      intro: 'A reliable tool takes more than code. Here, one accountable person covers each discipline:',
      items: [
        { icon: 'layers', title: 'Fits your systems', text: 'Solution architecture: the tool integrates with your existing systems and stays available, fast and secure as the company grows.' },
        { icon: 'code', title: 'Software development', text: 'Tested, readable and documented code.' },
        { icon: 'workflow', title: 'Deployment and monitoring', text: 'DevOps: deployment, monitoring and backups from day one.' },
        { icon: 'users', title: 'User experience', text: 'By the founder of the user experience centre of excellence at a leading Canadian capital markets organization: a tool teams actually adopt.' },
        { icon: 'shield-check', title: 'IT governance and cybersecurity', text: 'By a former IT director: access, data and risks stay under control.' }
      ]
    },
    limits: {
      title: 'Scope and limits',
      items: [
        'Small applications only: 2 to 6 weeks, at a fixed price.',
        'Beyond about $40,000 or 6 weeks, the engagement is split into phases or handed to a development partner.',
        'Optional monthly support and maintenance, price on request.',
        'Optional internal champions training: one or a few staff learn to use, evolve and maintain the tool, and to spot the next AI gains. The goal is your autonomy, not dependence on us. Price on request, or included in larger projects.',
        'Monessor resells no software and takes no commission: third-party tools are chosen for you and in your name.'
      ]
    },
    strategy: {
      text: 'Your AI strategy is set in the Full IT Audit, which costs out the most profitable uses of AI and places them in a prioritized plan. This offer delivers one item of that plan, or directly removes a friction point you already know.',
      link: { label: 'The Full IT Audit ↑', href: '#diagnostic' }
    }
  }}
  path={{
    id: 'approche',
    title: 'After the first look: a step-by-step path',
    intro: 'The Health Check or the Audit sets the direction. A first concrete gain, a custom tool or a vendor selection, produces quick results. Fractional IT leadership is the natural next step, once trust is established.',
    steps: [
      {
        title: 'IT Health Check or Full IT Audit',
        meta: '2 to 6 weeks · $4,500 or $23,750',
        text: 'The recommended starting point: the state of your systems, the risks, your priorities and, with the Audit, a costed plan, AI included.'
      },
      {
        title: 'Custom Software Solutions',
        meta: '2 to 6 weeks · from $15,000',
        text: 'A tool that removes one specific friction point. It can also be the starting point when the problem is already known.'
      },
      {
        title: 'Vendor selection and arbitration',
        meta: '4 to 8 weeks · from $15,000',
        text: 'Neutral requirements, a managed tender, an objective choice and negotiation, free of conflicts of interest.'
      },
      {
        title: 'Fractional IT leadership',
        meta: 'Monthly · from $8,000 a month',
        text: 'A seat on your leadership team, about one day a week, to steer execution, guide the teams and report to you.'
      }
    ]
  }}
  note={{
    id: 'essor',
    title: 'Possible financial assistance',
    text: 'The IT Health Check and the Full IT Audit are not funded by Investissement Québec’s ESSOR program, but they can help define a project that is. Depending on the project, a feasibility study, a full digital diagnostic and plan, or the implementation of that plan may be eligible, with up to 50% of eligible expenses reimbursed. The application must be filed before the engagement begins, approval is not guaranteed and the program ends on March 31, 2027. We can help you assess whether your project qualifies.'
  }}
  expertise={{
    id: 'expertise-complementaire',
    title: 'Targeted engagements and critical situations',
    items: [
      {
        icon: 'list-checks',
        title: 'Core software selection (ERP, CRM)',
        text: 'A neutral assessment of your needs, requirements, a managed tender and negotiation, shielded from reseller pressure.'
      },
      {
        icon: 'brain-circuit',
        title: 'Independent selection of AI partners',
        text: 'An assessment of your data and the most profitable uses of AI, to choose the right partners without buying into unrealistic promises.'
      },
      {
        icon: 'search-check',
        title: 'Technology assessment before a sale, acquisition or succession',
        text: 'The real value of digital assets, the stability of systems and what it will take to bring them up to standard, to secure the transaction.'
      },
      {
        icon: 'key-round',
        title: 'Regaining control from technology dependence',
        text: 'Recovering access, source code and data, so you keep your freedom of choice with your vendors.'
      }
    ]
  }}
  insights={{ title: 'Related insights', keys: ['sme-technology-strategy', 'replatforming-fable'], allLabel: 'Explore all insights' }}
  neutrality={{
    id: 'neutralite',
    title: 'No commissions. No software resale. Entirely on your side of the table.',
    text: 'Monessor resells no software (SaaS, ERP) and takes no vendor commissions: it is paid by its clients only. When it builds, it builds targeted tools, not platforms, and you own the code; the audit can just as well recommend an off-the-shelf product.',
    delivery: 'Every engagement is led personally by Alex Turcotte, Managing Partner. When an engagement calls for highly specialized expertise, Monessor brings in a specialist from its network.'
  }}
  other={{
    id: 'secteurs-regules',
    question: 'A financial institution or a FinTech?',
    label: 'Explore the IT Governance Review →',
    href: '/en/services/regulated-finance/'
  }}
/>
