---
import ServicePage from '../../../components/ServicePage.astro';

const url = 'https://www.monessor.com/en/services/sme/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Strategic IT management advisory for SMEs',
  serviceType: 'Strategic IT management advisory',
  url,
  provider: { '@type': 'ProfessionalService', name: 'Monessor', url: 'https://www.monessor.com' },
  areaServed: { '@type': 'Country', name: 'Canada' },
  availableLanguage: ['en', 'fr'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Offers for SMEs',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'IT Maturity Diagnostic and AI Alignment' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 12500, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Vendor selection and arbitration' },
        priceSpecification: { '@type': 'PriceSpecification', minPrice: 15000, priceCurrency: 'CAD' }
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Fractional IT leadership' },
        priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 8000, priceCurrency: 'CAD', unitText: 'month' }
      }
    ]
  }
};
---

<ServicePage
  locale="en"
  segment="pme"
  title="IT Maturity Diagnostic and IT Leadership for SMEs | Monessor"
  description="A 2-to-3-week IT Maturity Diagnostic from $12,500 for SMEs, then targeted deliverables and fractional IT leadership."
  jsonLd={jsonLd}
  hero={{
    kicker: 'Strategic IT management advisory · SMEs',
    title: 'Take back control of your technology investments.',
    lead: 'Monessor helps SME leaders reduce technical debt, prioritize critical projects and govern artificial intelligence with the discipline of regulated financial services. Our clients typically have between $5 million and $100 million in revenue, in manufacturing, distribution or services.',
    secondary: { label: 'See the Diagnostic', href: '#diagnostic' }
  }}
  issues={{
    id: 'symptomes',
    title: 'Where technology stops being a lever and becomes a risk',
    items: [
      {
        icon: 'wallet',
        title: 'Projects that drift and costs out of control',
        text: 'IT budgets and infrastructure bills that grow every year with no clear view of the return, and strategic deliveries that keep slipping.'
      },
      {
        icon: 'server-cog',
        title: 'Technical debt and critical dependencies',
        text: 'Complex, fragile core systems (ERP, CRM, in-house applications) kept running by a few key people or a single vendor, with no fallback.'
      },
      {
        icon: 'brain-circuit',
        title: 'AI under pressure, without a business case',
        text: 'Pressure to adopt artificial intelligence with no measurable return, at the risk of spending heavily without creating operational value.'
      },
      {
        icon: 'scale',
        title: 'A strained dialogue between finance and IT',
        text: 'A finance team focused on margins and the balance sheet, facing technical teams absorbed by day-to-day firefighting.'
      }
    ]
  }}
  offer={{
    id: 'diagnostic',
    kicker: 'Starting point',
    title: 'IT Maturity Diagnostic and AI Alignment',
    lead: 'A 2-to-3-week engagement that gives your leadership team and board a complete view of the state, risks and potential of your technology.',
    price: 'From $12,500, fixed-scope engagement.',
    items: [
      {
        icon: 'layers',
        title: 'Architecture and technical debt review',
        text: 'An independent look at the stability of core systems, failure risks and total cost of ownership.'
      },
      {
        icon: 'brain-circuit',
        title: 'AI use-case matrix',
        text: 'The processes you can automate in the near term, each with its estimated financial return, rather than projects driven by hype.'
      },
      {
        icon: 'handshake',
        title: 'Governance and vendor contract review',
        text: 'An independent view of vendor quotes, cloud costs and supplier dependencies, ahead of renegotiation.'
      },
      {
        icon: 'map',
        title: '18-month roadmap',
        text: 'A clear, prioritized and costed plan, ready to present to your board.'
      }
    ]
  }}
  path={{
    id: 'approche',
    title: 'After the diagnostic: a step-by-step path',
    intro: 'The diagnostic sets the direction. Two or three targeted deliverables produce the first results. Fractional IT leadership is the natural next step, once trust is established.',
    steps: [
      {
        title: 'IT Maturity Diagnostic',
        meta: '2 to 3 weeks · from $12,500',
        text: 'Where you stand: technical debt, risks and roadmap.'
      },
      {
        title: 'Vendor selection and arbitration',
        meta: '4 to 8 weeks · from $15,000',
        text: 'Neutral requirements, a managed tender, an objective choice and negotiation, free of conflicts of interest.'
      },
      {
        title: 'Fractional IT leadership',
        meta: 'Monthly · from $8,000 a month',
        text: 'A seat on your leadership team, about one day a week, to steer execution, guide the teams and report to the board.'
      }
    ]
  }}
  note={{
    title: 'Possible financial assistance',
    text: 'Depending on the project, a digital diagnostic, a system selection or the implementation of a digital plan may be eligible for Investissement Québec’s ESSOR program, which covers up to 50% of eligible expenses. The application must be filed before the engagement begins, approval is not guaranteed and the program ends on March 31, 2027. We can help you assess whether your project qualifies.'
  }}
  expertise={{
    id: 'expertise-complementaire',
    title: 'Targeted engagements and critical situations',
    items: [
      {
        icon: 'list-checks',
        title: 'Core software selection (ERP, CRM)',
        text: 'A neutral assessment of your needs, requirements, a managed tender and negotiation, shielded from reseller pressure.'
      },
      {
        icon: 'brain-circuit',
        title: 'Independent selection of AI partners',
        text: 'An assessment of your data maturity and high-return use cases, to choose the right partners without buying into unrealistic promises.'
      },
      {
        icon: 'search-check',
        title: 'Transaction technology due diligence (sale, acquisition, succession)',
        text: 'The real value of digital assets, system stability and technical debt, assessed to secure the transaction.'
      },
      {
        icon: 'key-round',
        title: 'Regaining control from technology dependence',
        text: 'Recovering access, source code and data, so you keep your freedom of choice with your vendors.'
      }
    ]
  }}
  insights={{ title: 'Related insights', keys: ['sme-technology-strategy', 'replatforming-fable'], allLabel: 'Explore all insights' }}
  neutrality={{
    id: 'neutralite',
    title: 'No commissions. No software resale. Entirely on your side of the table.',
    text: 'Monessor is not a development agency, a software reseller (SaaS, ERP) or an engineering subcontractor. It takes no vendor commissions: it is paid by its clients only, so its recommendations serve no interest but yours.',
    delivery: 'Every engagement is led personally by Alex Turcotte, Managing Partner. When an engagement calls for highly specialized expertise, Monessor brings in a specialist from its network.'
  }}
  other={{
    id: 'secteurs-regules',
    question: 'A financial institution or a FinTech?',
    label: 'Explore the IT Governance Review →',
    href: '/en/services/regulated-finance/'
  }}
/>
