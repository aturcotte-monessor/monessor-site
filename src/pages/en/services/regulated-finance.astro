---
import ServicePage from '../../../components/ServicePage.astro';

const url = 'https://www.monessor.com/en/services/regulated-finance/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'IT Governance and OSFI Compliance Review',
  serviceType: 'IT governance and regulatory compliance',
  url,
  provider: { '@type': 'ProfessionalService', name: 'Monessor', url: 'https://www.monessor.com' },
  areaServed: { '@type': 'Country', name: 'Canada' },
  audience: { '@type': 'BusinessAudience', name: 'Financial institutions and FinTechs' },
  availableLanguage: ['en', 'fr'],
  offers: {
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: 'IT Governance and OSFI Compliance Review' },
    description: 'Fixed-scope engagement, pricing on request.'
  }
};
---

<ServicePage
  locale="en"
  segment="sf"
  title="IT Governance and OSFI Compliance | Monessor"
  description="IT governance review for financial institutions and FinTechs: third-party risk (B-10), technology and cyber risk (B-13) and model risk management (E-23)."
  jsonLd={jsonLd}
  hero={{
    kicker: 'IT governance, risk and compliance · Financial services',
    title: 'Meet regulatory expectations without slowing your platforms down.',
    lead: 'Monessor designs and validates IT governance frameworks aligned with OSFI guidelines (third-party risk management, B-10; technology and cyber risk management, B-13; model risk management, E-23) for growing financial institutions and FinTechs.',
    secondary: { label: 'See the Review', href: '#revue' }
  }}
  issues={{
    id: 'enjeux',
    title: 'Where traditional governance holds execution back',
    items: [
      {
        icon: 'shield-check',
        title: 'Growing OSFI expectations',
        text: 'Increasing complexity in meeting expectations on technology and cyber risk (B-13), operational resilience and third-party risk management (B-10).'
      },
      {
        icon: 'file-text',
        title: 'The illusion of “paper” compliance',
        text: 'Policies written for auditors but disconnected from the code that teams and cloud providers actually run in production.'
      },
      {
        icon: 'brain-circuit',
        title: 'Model risk and AI (E-23)',
        text: 'Governing algorithms and automated decision models without slowing down digital product development.'
      },
      {
        icon: 'scale',
        title: 'Friction between risk and delivery',
        text: 'Heavy approval committees that stretch time to market and create tension between risk, compliance and product teams.'
      }
    ]
  }}
  offer={{
    id: 'revue',
    kicker: 'Starting point',
    title: 'IT Governance and OSFI Compliance Review',
    lead: 'A 3-to-4-week engagement to assess your technology compliance, identify third-party gaps and deliver a remediation matrix your risk and audit committee can act on directly.',
    price: 'Fixed-scope engagement, pricing on request.',
    items: [
      {
        icon: 'search-check',
        title: 'Gap analysis (B-10 and B-13)',
        text: 'A concrete assessment of how your infrastructure and policies align with OSFI expectations.'
      },
      {
        icon: 'handshake',
        title: 'Third-party risk assessment',
        text: 'Critical technology dependencies, vendor contracts and business continuity plans.'
      },
      {
        icon: 'brain-circuit',
        title: 'Model risk management framework (E-23)',
        text: 'Architecture guardrails and explainability mechanisms for using models and AI in a regulated setting.'
      },
      {
        icon: 'list-checks',
        title: 'Remediation matrix and action plan',
        text: 'A roadmap prioritized by risk level, to meet the expectations of auditors and regulators.'
      }
    ]
  }}
  expertise={{
    id: 'approche',
    title: 'Expertise for high-risk environments',
    numbered: true,
    items: [
      {
        icon: 'layers',
        title: 'Compliance by design',
        text: 'Regulatory constraints built directly into deployment pipelines (CI/CD) and cloud architectures, without slowing developers down.'
      },
      {
        icon: 'shield-check',
        title: 'Support during audits',
        text: 'Alongside leadership during internal and external audits and regulatory examinations.'
      },
      {
        icon: 'brain-circuit',
        title: 'Model governance and responsible AI',
        text: 'Governing the life cycle of predictive and generative models to keep them auditable and secure.'
      }
    ]
  }}
  insights={{ title: 'Related insights', keys: ['governance-speed', 'replatforming-fable'], allLabel: 'Explore all insights' }}
  neutrality={{
    id: 'neutralite',
    title: 'Engineering rigour, not just a legal opinion.',
    text: 'Monessor is neither a law firm nor an accounting audit firm. It combines a deep understanding of OSFI expectations with software architecture expertise to make your systems genuinely compliant in practice, not only on paper.',
    delivery: 'Every engagement is led personally by Alex Turcotte, Managing Partner. When an engagement calls for highly specialized expertise, Monessor brings in a specialist from its network.'
  }}
  other={{
    id: 'pme-etablies',
    question: 'Leading an SME?',
    label: 'Explore the IT Maturity Diagnostic →',
    href: '/en/services/sme/'
  }}
/>
